+static int jibo_file_rpc_flush(struct dfu_entity *dfu)
+{
+	struct mmc *mmc;
+	disk_partition_t part;
+	char label[DFU_NAME_SIZE];
+	unsigned int response_len = 0;
+	long request_len = dfu_file_buf_len;
+	int ret = 0;
+
+	/* A new request invalidates every old response, even if validation fails. */
+	jibo_file_response_len = 0;
+	jibo_file_response_label[0] = '\0';
+	dfu_file_buf_filled = -1;
+	if (jibo_file_alt(dfu, label, sizeof(label)) != JIBO_FILE_ALT_IN) {
+		dfu_file_buf_len = 0;
+		return -EPERM;
+	}
+	mmc = find_mmc_device(dfu->data.mmc.dev_num);
+	if (!mmc || mmc_init(mmc) ||
+	    jibo_file_partition(dfu, mmc, label, &part)) {
+		dfu_file_buf_len = 0;
+		return -EPERM;
+	}
+	if (request_len <= 0 || request_len > JIBO_FILE_RPC_MAX_REQUEST)
+		ret = -EINVAL;
+	else if (jibo_file_rpc_run(&mmc->block_dev, &part, dfu_file_buf,
+				   request_len, jibo_file_response,
+				   sizeof(jibo_file_response), &response_len))
+		ret = -EIO;
+	else if (response_len < 61 ||
+		 response_len > sizeof(jibo_file_response))
+		ret = -EIO;
+	else {
+		jibo_file_response_len = response_len;
+		jibo_file_response_dev = dfu->data.mmc.dev;
+		jibo_file_response_partno = dfu->data.mmc.part;
+		jibo_file_response_start = part.start;
+		jibo_file_response_size_lba = part.size;
+		strncpy(jibo_file_response_label, label,
+			sizeof(jibo_file_response_label) - 1);
+	}
+	dfu_file_buf_len = 0;
+	return ret;
+}
+
+static long jibo_file_response_size(struct dfu_entity *dfu)
+{
+	struct mmc *mmc;
+	disk_partition_t part;
