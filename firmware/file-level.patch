+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Bounded Jibo file mailbox.  This intentionally does not call ext4fs_init(),
+ * ext4fs_init_journal(), ext4fs_write(), or put_ext4().  It edits only one
+ * existing initialized extent and its inode size after a clean-journal check.
+ */
+#include <common.h>
+#include <blk.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <part.h>
+#include <stddef.h>
+#include <asm/byteorder.h>
+#include <u-boot/sha256.h>
+#include <asm/unaligned.h>
+#include <ext4fs.h>
+#include <ext_common.h>
+#include "ext4_common.h"
+#include "jibo_file_rpc.h"
+
+#define JIBO_FILE_MAX_PATH 255
+#define JIBO_FILE_MAX_BYTES 4096
+#define JIBO_FILE_REQ_HEADER 31
+#define JIBO_FILE_PRECONDITION 76
+#define JIBO_FILE_RESP_HEADER 61
+#define JIBO_EXT4_RECOVER 0x0004
+#define JIBO_EXT4_HAS_JOURNAL 0x0004
+#define JIBO_EXT4_ALLOWED_COMPAT 0x003c
+#define JIBO_EXT4_ALLOWED_INCOMPAT 0x0056
+#define JIBO_EXT4_ALLOWED_RO_COMPAT 0x007f
+#define JIBO_EXT4_GDT_CSUM 0x0010
+#define JIBO_EXT4_EXTENT_FL 0x00080000
+#define JIBO_EXT4_EXTENT_MAGIC 0xf30a
+#define JIBO_EXT4_JOURNAL_INO 8
+#define JIBO_EXT4_RESIZE_INODE 0x0010
+#define JIBO_EXT4_SPARSE_SUPER 0x0001
+#define JIBO_BG_INODE_UNINIT 0x0001
+#define JIBO_BG_BLOCK_UNINIT 0x0002
+#define JIBO_BG_INODE_ZEROED 0x0004
+#define JIBO_BG_FLAGS_KNOWN 0x0007
+#define JIBO_JBD_MAGIC 0xc03b3998
+#define JIBO_STATUS_BAD_REQUEST 1
+#define JIBO_STATUS_NO_PATH 2
+#define JIBO_STATUS_UNSUPPORTED 3
+#define JIBO_STATUS_UNCLEAN 4
+#define JIBO_STATUS_METADATA 5
+#define JIBO_STATUS_PRECONDITION 6
+#define JIBO_STATUS_IO 7
+#define JIBO_STATUS_POISONED 8
+
+static int jibo_file_poisoned;
+static u64 jibo_journal_start[4];
+static u32 jibo_journal_blocks[4];
+static unsigned int jibo_journal_count;
+
+static u32 jibo_get_be32(const u8 *p)
+{
+	return ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+		((u32)p[2] << 8) | p[3];
+}
+
+static void jibo_put_le32(u8 *p, u32 value)
+{
+	put_unaligned_le32(value, p);
+}
+
+static int jibo_utf8_ok(const u8 *s, unsigned int len)
+{
+	unsigned int i = 0;
+
+	while (i < len) {
+		u8 c = s[i++];
+		unsigned int need, code, minimum;
+
+		if (c < 0x80) {
+			if (c < 0x20 || c == 0x7f)
+				return 0;
+			continue;
+		}
+		if (c >= 0xc2 && c <= 0xdf) {
+			need = 1;
+			minimum = 0x80;
+			code = c & 0x1f;
+		} else if (c >= 0xe0 && c <= 0xef) {
+			need = 2;
+			minimum = 0x800;
+			code = c & 0x0f;
+		} else if (c >= 0xf0 && c <= 0xf4) {
+			need = 3;
+			minimum = 0x10000;
+			code = c & 0x07;
+		} else {
+			return 0;
+		}
+		if (need > len - i)
+			return 0;
+		while (need--) {
+			u8 next = s[i++];
+			if ((next & 0xc0) != 0x80)
+				return 0;
+			code = (code << 6) | (next & 0x3f);
+		}
+		if (code < minimum || (code >= 0xd800 && code <= 0xdfff) ||
+		    code > 0x10ffff)
+			return 0;
+	}
+	return 1;
+}
+
+static int jibo_path_ok(const u8 *path, unsigned int len)
+{
+	unsigned int i, start;
+
+	if (!path || !len || len > JIBO_FILE_MAX_PATH || path[0] != '/' ||
+	    len == 1 || path[len - 1] == '/' || !jibo_utf8_ok(path, len))
+		return 0;
+	start = 1;
+	for (i = 1; i <= len; ++i) {
+		if (i != len && path[i] != '/')
+			continue;
+		if (i == start || (i - start == 1 && path[start] == '.') ||
+		    (i - start == 2 && path[start] == '.' && path[start + 1] == '.'))
+			return 0;
+		if (i - start > 255)
+			return 0;
+		start = i + 1;
+	}
+	return 1;
+}
+
+static void jibo_sha256(const u8 *data, unsigned int len, u8 out[32])
+{
+	static const u8 empty[1];
+	sha256_csum_wd(data ? data : empty, len, out, CHUNKSZ_SHA256);
+}
+
+static u16 jibo_crc16(u16 crc, const u8 *data, unsigned int len)
+{
+	unsigned int i, bit;
+
+	for (i = 0; i < len; ++i) {
+		crc ^= data[i];
+		for (bit = 0; bit < 8; ++bit)
+			crc = (crc & 1) ? (crc >> 1) ^ 0xa001 : crc >> 1;
+	}
+	return crc;
+}
+
+static int jibo_group_checksum_ok(const u8 *super, unsigned int group,
+				  const struct ext2_block_group *desc)
+{
+	u32 group_le = cpu_to_le32(group);
+	u16 checksum;
+
+	if (!(get_unaligned_le32(super + 100) & JIBO_EXT4_GDT_CSUM))
+		return 1;
+	checksum = jibo_crc16(~0, super + 104, 16);
+	checksum = jibo_crc16(checksum, (const u8 *)&group_le,
+			      sizeof(group_le));
+	checksum = jibo_crc16(checksum, (const u8 *)desc,
+			      offsetof(struct ext2_block_group, bg_checksum));
+	return checksum == le16_to_cpu(desc->bg_checksum);
+}
+
+static int jibo_inode_allocated(unsigned int ino, const u8 *super,
+				u32 blocksize);
+
+static void jibo_make_response(const u8 *request_id, u8 status,
+			       const u8 *body, unsigned int body_len,
+			       u8 *response, unsigned int *response_len)
+{
+	static const u8 magic[8] = { 'J', 'I', 'B', 'O', 'R', '1', 0, 0 };
+
+	memcpy(response, magic, sizeof(magic));
+	memcpy(response + 8, request_id, 16);
+	response[24] = status;
+	jibo_put_le32(response + 25, body_len);
+	jibo_sha256(body, body_len, response + 29);
+	if (body_len && body != response + JIBO_FILE_RESP_HEADER)
+		memcpy(response + JIBO_FILE_RESP_HEADER, body, body_len);
+	*response_len = JIBO_FILE_RESP_HEADER + body_len;
+}
+
+static int jibo_check_clean_journal(const u8 *super, u32 blocksize)
+{
+	struct ext2_inode journal_inode;
+	struct ext4_extent_header *eh;
+	struct ext4_extent *extent;
+	struct ext_filesystem *fs = get_fs();
+	unsigned char *journal_sb;
+	u64 physical[4];
+	u32 length[4];
+	u64 total_blocks, covered_blocks = 0, file_size;
+	unsigned int journal_ino, i, entries;
+	u64 sector;
+	int ret = -1;
+
+	if (get_unaligned_le16(super + 58) != 1 ||
+	    (get_unaligned_le32(super + 96) & JIBO_EXT4_RECOVER))
+		return -1;
+	if (!(get_unaligned_le32(super + 92) & JIBO_EXT4_HAS_JOURNAL))
+		return 0;
+	journal_ino = get_unaligned_le32(super + 224);
+	if (journal_ino != JIBO_EXT4_JOURNAL_INO ||
+	    !ext4fs_root ||
+	    jibo_inode_allocated(journal_ino, super, blocksize) ||
+	    ext4fs_read_inode(ext4fs_root, journal_ino, &journal_inode) == 0 ||
+	    (le16_to_cpu(journal_inode.mode) & FILETYPE_INO_MASK) !=
+		FILETYPE_INO_REG ||
+	    !(le32_to_cpu(journal_inode.flags) & JIBO_EXT4_EXTENT_FL) ||
+	    le32_to_cpu(journal_inode.dir_acl) != 0)
+		return -1;
+	eh = (struct ext4_extent_header *)journal_inode.b.blocks.dir_blocks;
+	if (le16_to_cpu(eh->eh_magic) != JIBO_EXT4_EXTENT_MAGIC ||
+	    le16_to_cpu(eh->eh_depth) != 0 ||
+	    !(entries = le16_to_cpu(eh->eh_entries)) || entries > 4 ||
+	    le16_to_cpu(eh->eh_entries) > le16_to_cpu(eh->eh_max) ||
+	    le16_to_cpu(eh->eh_max) > 4 ||
+	    le32_to_cpu(((struct ext4_extent *)(eh + 1))->ee_block) != 0)
+		return -1;
+	total_blocks = __le32_to_cpu(ext4fs_root->sblock.total_blocks);
+	extent = (struct ext4_extent *)(eh + 1);
+	memset(physical, 0, sizeof(physical));
+	memset(length, 0, sizeof(length));
+	for (i = 0; i < entries; ++i) {
+		u32 raw_len = le16_to_cpu(extent[i].ee_len);
+		u32 logical = le32_to_cpu(extent[i].ee_block);
+
+		/* Values above 32768 encode unwritten extents. */
+		if (!raw_len || raw_len > 32768 ||
+		    logical != covered_blocks ||
+		    le16_to_cpu(extent[i].ee_start_hi) ||
+		    le32_to_cpu(extent[i].ee_start_lo) <
+			__le32_to_cpu(ext4fs_root->sblock.first_data_block))
+			return -1;
+		length[i] = raw_len;
+		physical[i] = le32_to_cpu(extent[i].ee_start_lo);
+		if (physical[i] >= total_blocks ||
+		    length[i] > total_blocks - physical[i])
+			return -1;
+		{
+			unsigned int prior;
+			for (prior = 0; prior < i; ++prior)
+				if (physical[i] < physical[prior] + length[prior] &&
+				    physical[prior] < physical[i] + length[i])
+					return -1;
+		}
+		covered_blocks += length[i];
+	}
+	file_size = le32_to_cpu(journal_inode.size);
+	if (!covered_blocks ||
+	    file_size != covered_blocks * blocksize ||
+	    le32_to_cpu(journal_inode.blockcnt) !=
+		covered_blocks * (blocksize / 512))
+		return -1;
+	if (physical[0] > (~(u64)0) / (blocksize / fs->dev_desc->blksz))
+		return -1;
+	sector = physical[0] * (blocksize / fs->dev_desc->blksz);
+	if (sector > fs->total_sect ||
+	    blocksize / fs->dev_desc->blksz > fs->total_sect - sector ||
+	    (u64)(lbaint_t)sector != sector)
+		return -1;
+	journal_sb = memalign(ARCH_DMA_MINALIGN, blocksize);
+	if (!journal_sb)
+		return -1;
+	if (ext4fs_devread((lbaint_t)sector, 0, blocksize,
+			   (char *)journal_sb) &&
+	    jibo_get_be32(journal_sb) == JIBO_JBD_MAGIC &&
+	    jibo_get_be32(journal_sb + 12) == blocksize &&
+	    jibo_get_be32(journal_sb + 16) == covered_blocks &&
+	    jibo_get_be32(journal_sb + 28) == 0) {
+		memcpy(jibo_journal_start, physical, sizeof(physical));
+		memcpy(jibo_journal_blocks, length, sizeof(length));
+		jibo_journal_count = entries;
+		ret = 0;
+	}
+	free(journal_sb);
+	return ret;
+}
+
+static int jibo_path_lookup(const u8 *path, unsigned int path_len,
+			    const u8 *super, u32 blocksize,
+			    struct ext2fs_node **result, int *result_ino)
+{
+	struct ext2fs_node *current, *next = NULL;
+	struct ext2_inode inode;
+	unsigned int start = 1, i;
+	int found_type, mode_type, status, is_root = 1;
+	char component[256];
+
+	current = &ext4fs_root->diropen;
+	if (jibo_inode_allocated(EXT2_ROOT_INO, super, blocksize))
+		return -1;
+	for (i = 1; i <= path_len; ++i) {
+		if (i != path_len && path[i] != '/')
+			continue;
+		memcpy(component, path + start, i - start);
+		component[i - start] = '\0';
+		if ((le16_to_cpu(current->inode.mode) & FILETYPE_INO_MASK) !=
+		    FILETYPE_INO_DIRECTORY) {
+			status = -1;
+			goto out;
+		}
+		next = NULL;
+		found_type = FILETYPE_UNKNOWN;
+		if (ext4fs_iterate_dir(current, component, &next, &found_type) != 1 ||
+		    !next || next->ino <= 0 ||
+		    (unsigned int)next->ino >
+			__le32_to_cpu(ext4fs_root->sblock.total_inodes)) {
+			status = -1;
+			goto out;
+		}
+		if (jibo_inode_allocated(next->ino, super, blocksize) ||
+		    ext4fs_read_inode(next->data, next->ino, &inode) == 0) {
+			status = -1;
+			goto out;
+		}
+		next->inode = inode;
+		next->inode_read = 1;
+		mode_type = le16_to_cpu(inode.mode) & FILETYPE_INO_MASK;
+		if (mode_type == FILETYPE_INO_DIRECTORY)
+			mode_type = FILETYPE_DIRECTORY;
+		else if (mode_type == FILETYPE_INO_REG)
+			mode_type = FILETYPE_REG;
+		else if (mode_type == FILETYPE_INO_SYMLINK)
+			mode_type = FILETYPE_SYMLINK;
+		else
+			mode_type = FILETYPE_UNKNOWN;
+		if (mode_type == FILETYPE_UNKNOWN ||
+		    (found_type != FILETYPE_UNKNOWN && found_type != mode_type)) {
+			status = -1;
+			goto out;
+		}
+		if (current != &ext4fs_root->diropen)
+			ext4fs_free_node(current, &ext4fs_root->diropen);
+		current = next;
+		next = NULL;
+		is_root = 0;
+		start = i + 1;
+	}
+	*result_ino = current->ino;
+	*result = current;
+	return 0;
+
+out:
+	if (next && next != &ext4fs_root->diropen)
+		ext4fs_free_node(next, &ext4fs_root->diropen);
+	if (!is_root && current != &ext4fs_root->diropen)
+		ext4fs_free_node(current, &ext4fs_root->diropen);
+	return status;
+}
+
+static int jibo_group_has_super(unsigned int group, const u8 *super)
+{
+	u32 features = get_unaligned_le32(super + 100);
+	unsigned int factor;
+
+	if (!(features & JIBO_EXT4_SPARSE_SUPER) || group <= 1)
+		return 1;
+	for (factor = 3; factor <= 7; factor += 2) {
+		unsigned int value = group;
+
+		while (value > 1 && value % factor == 0)
+			value /= factor;
+		if (value == 1)
+			return 1;
+	}
+	return 0;
+}
+
+static int jibo_block_is_reserved(u64 block, const u8 *super,
+				  u32 blocksize, u64 group_count)
+{
+	u64 first = get_unaligned_le32(super + 20);
+	u64 blocks_per_group = get_unaligned_le32(super + 32);
+	u64 descriptor_blocks, descriptors_per_block;
+	u64 reserved_gdt = get_unaligned_le16(super + 206);
+	u32 first_meta_bg = get_unaligned_le32(super + 260);
+	u32 incompat = get_unaligned_le32(super + 96);
+	u32 compat = get_unaligned_le32(super + 92);
+	int meta_bg = !!(incompat & 0x0010);
+	u64 group;
+
+	if (!block || !blocks_per_group || !group_count)
+		return 1;
+	descriptor_blocks = (group_count * sizeof(struct ext2_block_group) +
+			     blocksize - 1) / blocksize;
+	descriptors_per_block = blocksize / sizeof(struct ext2_block_group);
+	if (!descriptors_per_block || first_meta_bg > descriptor_blocks ||
+	    (meta_bg && (compat & JIBO_EXT4_RESIZE_INODE)))
+		return 1;
+
+	/* Protect primary classic descriptors and their backup copies. */
+	{
+		u64 copy_count = meta_bg ? first_meta_bg : descriptor_blocks;
+		u64 i;
+
+		for (i = 0; i < copy_count; ++i)
+			if (block == first + 1 + i)
+				return 1;
+		if (reserved_gdt && !meta_bg &&
+		    (compat & JIBO_EXT4_RESIZE_INODE) &&
+		    block >= first + 1 + descriptor_blocks &&
+		    block - (first + 1 + descriptor_blocks) < reserved_gdt)
+			return 1;
+	}
+
+	for (group = 0; group < group_count; ++group) {
+		u64 group_start = first + group * blocks_per_group;
+		u64 copy_count;
+
+		if (!jibo_group_has_super(group, super))
+			continue;
+		if (block == group_start)
+			return 1;
+		copy_count = meta_bg ? first_meta_bg : descriptor_blocks;
+		/* Classic descriptor backups stop at the first meta-group. */
+		if (meta_bg && group >= first_meta_bg * descriptors_per_block)
+			copy_count = 0;
+		if (block > group_start && block - group_start <= copy_count)
+			return 1;
+		if (!meta_bg && reserved_gdt &&
+		    (compat & JIBO_EXT4_RESIZE_INODE) &&
+		    block > group_start + descriptor_blocks &&
+		    block - (group_start + descriptor_blocks + 1) < reserved_gdt)
+			return 1;
+	}
+
+	if (meta_bg) {
+		u64 desc;
+
+		for (desc = first_meta_bg; desc < descriptor_blocks; ++desc) {
+			u64 base = desc * descriptors_per_block;
+			u64 candidates[3];
+			unsigned int i;
+
+			candidates[0] = base;
+			candidates[1] = base + 1;
+			candidates[2] = base + descriptors_per_block - 1;
+			for (i = 0; i < ARRAY_SIZE(candidates); ++i) {
+				u64 replica = candidates[i];
+				u64 location;
+
+				if (replica >= group_count)
+					continue;
+				location = first + replica * blocks_per_group;
+				if (jibo_group_has_super(replica, super))
+					location++;
+				if (block == location)
+					return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+static int jibo_file_data_block_safe(u64 block, u32 blocksize, u8 *super)
+{
+	struct ext_filesystem *fs = get_fs();
+	struct ext2_block_group desc;
+	u8 *bitmap = NULL;
+	u64 total, first, group_count, inode_table_blocks;
+	u64 group_start, group_end, inode_table_end;
+	u64 target_bitmap = 0, target_offset = 0;
+	u32 blocks_per_group, inodes_per_group, inode_size, target_group;
+	u32 group;
+	int result = -1;
+
+	total = __le32_to_cpu(ext4fs_root->sblock.total_blocks);
+	first = __le32_to_cpu(ext4fs_root->sblock.first_data_block);
+	blocks_per_group = __le32_to_cpu(ext4fs_root->sblock.blocks_per_group);
+	inodes_per_group = __le32_to_cpu(ext4fs_root->sblock.inodes_per_group);
+	inode_size = __le32_to_cpu(ext4fs_root->sblock.revision_level) ?
+		__le16_to_cpu(ext4fs_root->sblock.inode_size) : 128;
+	if (!blocks_per_group || !inodes_per_group || !inode_size ||
+	    block < first || block >= total || !fs->dev_desc ||
+	    blocksize % fs->dev_desc->blksz ||
+	    blocks_per_group > blocksize * 8U)
+		return -1;
+	group_count = (total - first + blocks_per_group - 1) / blocks_per_group;
+	/* Bound descriptor scanning on malformed volumes and keep it predictable. */
+	if (!group_count || group_count > 4096)
+		return -1;
+	target_group = (block - first) / blocks_per_group;
+	target_offset = (block - first) % blocks_per_group;
+	if (jibo_block_is_reserved(block, super, blocksize, group_count))
+		return -1;
+	inode_table_blocks = ((u64)inodes_per_group * inode_size +
+			      blocksize - 1) / blocksize;
+
+	for (group = 0; group < group_count; ++group) {
+		u64 block_bitmap, inode_bitmap, inode_table;
+
+		group_start = first + (u64)group * blocks_per_group;
+		group_end = min_t(u64, total, group_start + blocks_per_group);
+		if (!ext4fs_read_block_group(ext4fs_root, group, &desc) ||
+		    !jibo_group_checksum_ok(super, group, &desc))
+			return -1;
+		if (le16_to_cpu(desc.bg_flags) & ~JIBO_BG_FLAGS_KNOWN)
+			return -1;
+		block_bitmap = __le32_to_cpu(desc.block_id);
+		inode_bitmap = __le32_to_cpu(desc.inode_id);
+		inode_table = __le32_to_cpu(desc.inode_table_id);
+		inode_table_end = inode_table + inode_table_blocks;
+		/* Flex-bg is not enabled, so each group's metadata stays in it. */
+		if (!block_bitmap || !inode_bitmap || !inode_table ||
+		    block_bitmap < group_start || block_bitmap >= group_end ||
+		    inode_bitmap < group_start || inode_bitmap >= group_end ||
+		    inode_table < group_start || inode_table_end > group_end ||
+		    block_bitmap == inode_bitmap || block_bitmap == inode_table ||
+		    inode_bitmap == inode_table ||
+		    (block_bitmap >= inode_table && block_bitmap < inode_table_end) ||
+		    (inode_bitmap >= inode_table && inode_bitmap < inode_table_end))
+			return -1;
+		if (block == block_bitmap || block == inode_bitmap ||
+		    (block >= inode_table && block < inode_table_end))
+			return -1;
+		if (group == target_group) {
+			if (le16_to_cpu(desc.bg_flags) & JIBO_BG_BLOCK_UNINIT)
+				return -1;
+			target_bitmap = block_bitmap;
+		}
+	}
+	if (target_offset >= blocksize * 8U)
+		return -1;
+	bitmap = memalign(ARCH_DMA_MINALIGN, blocksize);
+	if (!bitmap)
+		return -1;
+	if (!ext4fs_devread((lbaint_t)(target_bitmap *
+					(blocksize / fs->dev_desc->blksz)),
+			    0, blocksize, (char *)bitmap))
+		goto out;
+	if (!(bitmap[target_offset >> 3] & (1U << (target_offset & 7))))
+		goto out;
+	result = 0;
+out:
+	free(bitmap);
+	return result;
+}
+
+static int jibo_inode_allocated(unsigned int ino, const u8 *super,
+				u32 blocksize)
+{
+	struct ext_filesystem *fs = get_fs();
+	struct ext2_block_group desc;
+	u8 *bitmap = NULL;
+	u32 total_inodes, inodes_per_group, blocks_per_group;
+	u32 inode_size, index, group;
+	u64 first, total_blocks, group_start, group_end;
+	u64 block_bitmap, inode_bitmap, inode_table, inode_table_blocks;
+	u64 sector;
+	u16 flags;
+	int result = -1;
+
+	total_inodes = __le32_to_cpu(ext4fs_root->sblock.total_inodes);
+	inodes_per_group = __le32_to_cpu(ext4fs_root->sblock.inodes_per_group);
+	blocks_per_group = __le32_to_cpu(ext4fs_root->sblock.blocks_per_group);
+	total_blocks = __le32_to_cpu(ext4fs_root->sblock.total_blocks);
+	first = __le32_to_cpu(ext4fs_root->sblock.first_data_block);
+	inode_size = __le32_to_cpu(ext4fs_root->sblock.revision_level) ?
+		__le16_to_cpu(ext4fs_root->sblock.inode_size) : 128;
+	if (!ino || ino > total_inodes || !inodes_per_group || !blocks_per_group ||
+	    inodes_per_group > blocksize * 8U || !fs->dev_desc ||
+	    blocksize % fs->dev_desc->blksz || !inode_size)
+		return -1;
+	index = ino - 1;
+	group = index / inodes_per_group;
+	if (!ext4fs_read_block_group(ext4fs_root, group, &desc) ||
+	    !jibo_group_checksum_ok(super, group, &desc))
+		return -1;
+	flags = le16_to_cpu(desc.bg_flags);
+	if ((flags & ~JIBO_BG_FLAGS_KNOWN) ||
+	    (flags & JIBO_BG_INODE_UNINIT))
+		return -1;
+	group_start = first + (u64)group * blocks_per_group;
+	group_end = min_t(u64, total_blocks, group_start + blocks_per_group);
+	block_bitmap = __le32_to_cpu(desc.block_id);
+	inode_bitmap = __le32_to_cpu(desc.inode_id);
+	inode_table = __le32_to_cpu(desc.inode_table_id);
+	inode_table_blocks = ((u64)inodes_per_group * inode_size +
+			       blocksize - 1) / blocksize;
+	if (!block_bitmap || !inode_bitmap || !inode_table ||
+	    block_bitmap < group_start || block_bitmap >= group_end ||
+	    inode_bitmap < group_start || inode_bitmap >= group_end ||
+	    inode_table < group_start || inode_table + inode_table_blocks > group_end ||
+	    block_bitmap == inode_bitmap || block_bitmap == inode_table ||
+	    inode_bitmap == inode_table ||
+	    (block_bitmap >= inode_table && block_bitmap < inode_table + inode_table_blocks) ||
+	    (inode_bitmap >= inode_table && inode_bitmap < inode_table + inode_table_blocks))
+		return -1;
+	if ((u64)(index % inodes_per_group) >= blocksize * 8U ||
+	    inode_bitmap > (~(u64)0) / (blocksize / fs->dev_desc->blksz))
+		return -1;
+	sector = inode_bitmap * (blocksize / fs->dev_desc->blksz);
+	if (sector > fs->total_sect ||
+	    blocksize / fs->dev_desc->blksz > fs->total_sect - sector)
+		return -1;
+	bitmap = memalign(ARCH_DMA_MINALIGN, blocksize);
+	if (!bitmap)
+		return -1;
+	if (!ext4fs_devread((lbaint_t)sector, 0, blocksize, (char *)bitmap))
+		goto out;
+	if (bitmap[(index % inodes_per_group) >> 3] &
+	    (1U << ((index % inodes_per_group) & 7)))
+		result = 0;
+out:
+	free(bitmap);
+	return result;
+}
+
+static int jibo_inode_table_location_safe(unsigned int ino, const u8 *super,
+					  u32 blocksize, u64 *block,
+					  u32 *offset)
+{
+	struct ext2_block_group desc;
+	u32 total_inodes, inodes_per_group, blocks_per_group;
+	u32 inode_size, index, group, inodes_per_block;
+	u64 first, total_blocks, group_count, group_start, group_end;
+	u64 block_bitmap, inode_bitmap, inode_table, table_blocks, expected;
+	u16 flags;
+
+	total_inodes = __le32_to_cpu(ext4fs_root->sblock.total_inodes);
+	inodes_per_group = __le32_to_cpu(ext4fs_root->sblock.inodes_per_group);
+	blocks_per_group = __le32_to_cpu(ext4fs_root->sblock.blocks_per_group);
+	total_blocks = __le32_to_cpu(ext4fs_root->sblock.total_blocks);
+	first = __le32_to_cpu(ext4fs_root->sblock.first_data_block);
+	inode_size = __le32_to_cpu(ext4fs_root->sblock.revision_level) ?
+		__le16_to_cpu(ext4fs_root->sblock.inode_size) : 128;
+	if (!ino || ino > total_inodes || !inodes_per_group ||
+	    !blocks_per_group || !inode_size || blocksize % inode_size ||
+	    !blocksize)
+		return -1;
+	index = ino - 1;
+	group = index / inodes_per_group;
+	group_count = (total_blocks - first + blocks_per_group - 1) /
+		blocks_per_group;
+	if (group >= group_count || group_count > 4096 ||
+	    !ext4fs_read_block_group(ext4fs_root, group, &desc) ||
+	    !jibo_group_checksum_ok(super, group, &desc))
+		return -1;
+	flags = le16_to_cpu(desc.bg_flags);
+	if ((flags & ~JIBO_BG_FLAGS_KNOWN) ||
+	    (flags & JIBO_BG_INODE_UNINIT))
+		return -1;
+	group_start = first + (u64)group * blocks_per_group;
+	group_end = min_t(u64, total_blocks, group_start + blocks_per_group);
+	block_bitmap = __le32_to_cpu(desc.block_id);
+	inode_bitmap = __le32_to_cpu(desc.inode_id);
+	inode_table = __le32_to_cpu(desc.inode_table_id);
+	table_blocks = ((u64)inodes_per_group * inode_size + blocksize - 1) /
+		blocksize;
+	if (!block_bitmap || !inode_bitmap || !inode_table ||
+	    block_bitmap < group_start || block_bitmap >= group_end ||
+	    inode_bitmap < group_start || inode_bitmap >= group_end ||
+	    inode_table < group_start || inode_table + table_blocks > group_end ||
+	    block_bitmap == inode_bitmap || block_bitmap == inode_table ||
+	    inode_bitmap == inode_table ||
+	    (block_bitmap >= inode_table && block_bitmap < inode_table + table_blocks) ||
+	    (inode_bitmap >= inode_table && inode_bitmap < inode_table + table_blocks))
+		return -1;
+	inodes_per_block = blocksize / inode_size;
+	expected = inode_table + (index % inodes_per_group) / inodes_per_block;
+	if (expected >= total_blocks ||
+	    jibo_block_is_reserved(expected, super, blocksize, group_count))
+		return -1;
+	*block = expected;
+	*offset = ((index % inodes_per_group) % inodes_per_block) * inode_size;
+	return 0;
+}
+
+static int jibo_file_metadata(struct ext2fs_node *node, int ino,
+			      struct ext2_inode *inode, u8 *super,
+			      u8 *stat_buf, u32 blocksize,
+			      u64 *data_block)
+{
+	struct ext4_extent_header *eh;
+	struct ext4_extent *extent;
+	unsigned long long phys;
+	u32 uid, gid, size;
+
+	if ((le16_to_cpu(inode->mode) & FILETYPE_INO_MASK) != FILETYPE_INO_REG ||
+	    le16_to_cpu(inode->nlinks) != 1 ||
+	    !(le32_to_cpu(inode->flags) & JIBO_EXT4_EXTENT_FL) ||
+	    le32_to_cpu(inode->dir_acl) != 0)
+		return -1;
+	eh = (struct ext4_extent_header *)inode->b.blocks.dir_blocks;
+	if (le16_to_cpu(eh->eh_magic) != JIBO_EXT4_EXTENT_MAGIC ||
+	    le16_to_cpu(eh->eh_depth) != 0 || le16_to_cpu(eh->eh_entries) != 1)
+		return -1;
+	extent = (struct ext4_extent *)(eh + 1);
+	if (le32_to_cpu(extent->ee_block) != 0 ||
+	    le16_to_cpu(extent->ee_len) != 1)
+		return -1;
+	phys = ((unsigned long long)le16_to_cpu(extent->ee_start_hi) << 32) |
+		le32_to_cpu(extent->ee_start_lo);
+	if (le16_to_cpu(extent->ee_start_hi) ||
+	    phys >= __le32_to_cpu(node->data->sblock.total_blocks) ||
+	    le32_to_cpu(inode->blockcnt) != blocksize / 512 || !phys ||
+	    jibo_file_data_block_safe(phys, blocksize, super))
+		return -1;
+	{
+		unsigned int i;
+		for (i = 0; i < jibo_journal_count; ++i)
+			if (phys >= jibo_journal_start[i] &&
+			    phys - jibo_journal_start[i] < jibo_journal_blocks[i])
+				return -1;
+	}
+	size = le32_to_cpu(inode->size);
+	if (size > JIBO_FILE_MAX_BYTES || size > blocksize)
+		return -1;
+	uid = le16_to_cpu(inode->uid) |
+		((u32)get_unaligned_le16((u8 *)inode + 120) << 16);
+	gid = le16_to_cpu(inode->gid) |
+		((u32)get_unaligned_le16((u8 *)inode + 122) << 16);
+	if (stat_buf) {
+		put_unaligned_le64((u64)ino, stat_buf);
+		jibo_put_le32(stat_buf + 8, size);
+		jibo_put_le32(stat_buf + 12, blocksize);
+		jibo_put_le32(stat_buf + 16, uid);
+		jibo_put_le32(stat_buf + 20, gid);
+		jibo_put_le32(stat_buf + 24, le16_to_cpu(inode->mode));
+		jibo_put_le32(stat_buf + 28, le16_to_cpu(inode->nlinks));
+		jibo_put_le32(stat_buf + 32, 1);
+		memcpy(stat_buf + 36, super + 104, 16);
+	}
+	*data_block = phys;
+	return 0;
+}
+
+static int jibo_raw_read(struct blk_desc *dev, disk_partition_t *part,
+			 u64 fs_block, u32 blocksize, u8 *buf)
+{
+	u64 sector, sectors;
+
+	if (!dev || dev->blksz != 512 || part->blksz != 512 ||
+	    blocksize % dev->blksz || fs_block > (~(u64)0) / blocksize ||
+	    part->start > dev->lba || part->size > dev->lba - part->start)
+		return -1;
+	sectors = blocksize / dev->blksz;
+	sector = fs_block * sectors;
+	if (sector > part->size || sectors > part->size - sector ||
+	    part->start > dev->lba || sector + part->start > dev->lba ||
+	    sectors > dev->lba - (part->start + sector))
+		return -1;
+	return blk_dread(dev, part->start + sector, sectors, buf) == sectors ? 0 : -1;
+}
+
+static int jibo_raw_write(struct blk_desc *dev, disk_partition_t *part,
+			  u64 fs_block, u32 blocksize, const u8 *buf)
+{
+	u64 sector, sectors;
+
+	if (!dev || dev->blksz != 512 || part->blksz != 512 ||
+	    blocksize % dev->blksz || fs_block > (~(u64)0) / blocksize ||
+	    part->start > dev->lba || part->size > dev->lba - part->start)
+		return -1;
+	sectors = blocksize / dev->blksz;
+	sector = fs_block * sectors;
+	if (sector > part->size || sectors > part->size - sector ||
+	    part->start > dev->lba || sector + part->start > dev->lba ||
+	    sectors > dev->lba - (part->start + sector))
+		return -1;
+	return blk_dwrite(dev, part->start + sector, sectors, buf) == sectors ? 0 : -1;
+}
+
+static int jibo_inode_matches(struct ext2_inode *actual,
+			      struct ext2_inode *expected)
+{
+	return !memcmp(actual, expected, sizeof(*actual));
+}
+
+static int jibo_write_file(struct blk_desc *dev, disk_partition_t *part,
+			   struct ext2fs_node *node, int ino,
+			   struct ext2_inode *inode,
+			   const u8 *pre, const u8 *new_data, u32 new_len,
+			   u32 blocksize, u8 *super, u64 data_block)
+{
+	struct ext2_inode raw_inode, verify_inode;
+	struct ext2fs_node verify_node;
+	u8 *data_buf = NULL, *read_buf = NULL, *inode_buf = NULL;
+	u8 *verify_block = NULL;
+	u8 digest[32];
+	u64 inode_block, safe_inode_block;
+	u32 inode_off, safe_inode_off;
+	loff_t actual;
+	int status = JIBO_STATUS_IO;
+
+	if (new_len == 0 || new_len > JIBO_FILE_MAX_BYTES ||
+	    new_len > blocksize || new_len > get_unaligned_le32(pre + 12))
+		return JIBO_STATUS_UNSUPPORTED;
+	data_buf = memalign(ARCH_DMA_MINALIGN, blocksize);
+	read_buf = memalign(ARCH_DMA_MINALIGN, blocksize);
+	inode_buf = memalign(ARCH_DMA_MINALIGN, blocksize);
+	verify_block = memalign(ARCH_DMA_MINALIGN, blocksize);
+	if (!data_buf || !read_buf || !inode_buf || !verify_block)
+		goto out;
+	memset(data_buf, 0, blocksize);
+	memcpy(data_buf, new_data, new_len);
+	if (ext4fs_inode_location(ext4fs_root, ino, &inode_block, &inode_off) ||
+	    jibo_inode_table_location_safe(ino, super, blocksize,
+					   &safe_inode_block, &safe_inode_off) ||
+	    inode_block != safe_inode_block || inode_off != safe_inode_off ||
+	    jibo_raw_read(dev, part, inode_block, blocksize, inode_buf))
+		goto out;
+	memcpy(&raw_inode, inode_buf + inode_off, sizeof(raw_inode));
+	if (!jibo_inode_matches(&raw_inode, inode) ||
+	    jibo_raw_read(dev, part, data_block, blocksize, read_buf))
+		goto out;
+	jibo_sha256(read_buf, get_unaligned_le32(pre + 8), digest);
+	if (memcmp(digest, pre + 44, sizeof(digest)))
+		goto out;
+	if (jibo_raw_write(dev, part, data_block, blocksize, data_buf))
+		goto poison;
+	blkcache_invalidate(dev->if_type, dev->devnum);
+	if (jibo_raw_read(dev, part, data_block, blocksize, read_buf) ||
+	    memcmp(data_buf, read_buf, blocksize))
+		goto poison;
+	if (jibo_raw_read(dev, part, inode_block, blocksize, inode_buf))
+		goto poison;
+	memcpy(&raw_inode, inode_buf + inode_off, sizeof(raw_inode));
+	if (!jibo_inode_matches(&raw_inode, inode))
+		goto poison;
+	put_unaligned_le32(new_len, (u8 *)&raw_inode + 4);
+	memcpy(inode_buf + inode_off, &raw_inode, sizeof(raw_inode));
+	if (jibo_raw_write(dev, part, inode_block, blocksize, inode_buf))
+		goto poison;
+	blkcache_invalidate(dev->if_type, dev->devnum);
+	if (jibo_raw_read(dev, part, inode_block, blocksize, verify_block))
+		goto poison;
+	memcpy(&verify_inode, verify_block + inode_off, sizeof(verify_inode));
+	if (le32_to_cpu(verify_inode.size) != new_len ||
+	    memcmp((u8 *)&verify_inode, (u8 *)inode, 4) ||
+	    memcmp((u8 *)&verify_inode + 8, (u8 *)inode + 8,
+		   sizeof(verify_inode) - 8))
+		goto poison;
+	memset(&verify_node, 0, sizeof(verify_node));
+	verify_node.data = node->data;
+	verify_node.ino = ino;
+	verify_node.inode = verify_inode;
+	verify_node.inode_read = 1;
+	if (ext4fs_read_file(&verify_node, 0, new_len, (char *)read_buf,
+			     &actual) || actual != new_len ||
+	    memcmp(read_buf, new_data, new_len))
+		goto poison;
+	status = 0;
+	goto out;
+
+poison:
+	jibo_file_poisoned = 1;
+	status = JIBO_STATUS_IO;
+out:
+	if (data_buf)
+		free(data_buf);
+	if (read_buf)
+		free(read_buf);
+	if (inode_buf)
+		free(inode_buf);
+	if (verify_block)
+		free(verify_block);
+	return status;
+}
+
+int jibo_file_rpc_run(struct blk_desc *dev, disk_partition_t *part,
+		      const unsigned char *request, unsigned int request_len,
+		      unsigned char *response, unsigned int response_capacity,
+		      unsigned int *response_len)
+{
+	static const u8 request_magic[8] = { 'J', 'I', 'B', 'O', 'F', 'L', '1', 0 };
+	struct ext2fs_node *node = NULL;
+	struct ext2_inode inode;
+	u8 super[1024], request_id[16], digest[32], stat_buf[52];
+	u8 *file_data = NULL;
+	u32 path_len, content_len, blocksize, status = JIBO_STATUS_BAD_REQUEST;
+	u32 operation, inode_no = 0, file_size = 0;
+	u64 data_block = 0;
+	unsigned int expected_len, body_len = 0;
+	int found_ino = 0;
+	const u8 *path, *pre = NULL, *new_data = NULL;
+	loff_t actual;
+	int mounted = 0;
+
+	memset(request_id, 0, sizeof(request_id));
+	if (!response || !response_len ||
+	    response_capacity < JIBO_FILE_RPC_MAX_RESPONSE)
+		return -1;
+	memset(jibo_journal_start, 0, sizeof(jibo_journal_start));
+	memset(jibo_journal_blocks, 0, sizeof(jibo_journal_blocks));
+	jibo_journal_count = 0;
+	if (request && request_len >= JIBO_FILE_REQ_HEADER)
+		memcpy(request_id, request + 15, sizeof(request_id));
+	if (request_len > JIBO_FILE_RPC_MAX_REQUEST || !request || !part || !dev)
+		goto respond;
+	if (request_len < JIBO_FILE_REQ_HEADER ||
+	    memcmp(request, request_magic, sizeof(request_magic)))
+		goto respond;
+	operation = request[8];
+	path_len = get_unaligned_le16(request + 9);
+	content_len = get_unaligned_le32(request + 11);
+	if (operation < 1 || operation > 3 || !path_len ||
+	    path_len > JIBO_FILE_MAX_PATH)
+		goto respond;
+	expected_len = JIBO_FILE_REQ_HEADER + path_len;
+	if (operation == 2) {
+		if (!content_len || content_len > JIBO_FILE_MAX_BYTES ||
+		    expected_len + JIBO_FILE_PRECONDITION + content_len != request_len)
+			goto respond;
+		pre = request + expected_len;
+		new_data = pre + JIBO_FILE_PRECONDITION;
+		expected_len += JIBO_FILE_PRECONDITION + content_len;
+	} else if (content_len || expected_len != request_len) {
+		goto respond;
+	}
+	path = request + JIBO_FILE_REQ_HEADER;
+	if (!jibo_path_ok(path, path_len))
+		goto respond;
+	if (jibo_file_poisoned) {
+		status = JIBO_STATUS_POISONED;
+		goto respond;
+	}
+	if (dev->blksz != 512 || part->blksz != 512 || !part->size ||
+	    part->start > dev->lba || part->size > dev->lba - part->start)
+		goto respond;
+	ext4fs_close();
+	ext4fs_set_blk_dev(dev, part);
+	if (!ext4fs_devread(2, 0, sizeof(super), (char *)super)) {
+		status = JIBO_STATUS_IO;
+		goto respond;
+	}
+	if ((get_unaligned_le32(super + 92) & ~JIBO_EXT4_ALLOWED_COMPAT) ||
+	    (get_unaligned_le32(super + 96) & ~JIBO_EXT4_ALLOWED_INCOMPAT) ||
+	    (get_unaligned_le32(super + 100) & ~JIBO_EXT4_ALLOWED_RO_COMPAT)) {
+		status = JIBO_STATUS_UNSUPPORTED;
+		goto respond;
+	}
+	if (get_unaligned_le32(super + 24) > 2) {
+		status = JIBO_STATUS_UNSUPPORTED;
+		goto respond;
+	}
+	blocksize = 1024U << get_unaligned_le32(super + 24);
+	{
+		u32 revision = get_unaligned_le32(super + 76);
+		u32 inode_size = revision ? get_unaligned_le16(super + 88) : 128;
+		u32 block_count = get_unaligned_le32(super + 4);
+		u32 inode_count = get_unaligned_le32(super + 0);
+		u32 blocks_per_group = get_unaligned_le32(super + 32);
+		u32 inodes_per_group = get_unaligned_le32(super + 40);
+		u32 first_data_block = get_unaligned_le32(super + 20);
+		u32 incompat = get_unaligned_le32(super + 96);
+		u32 compat = get_unaligned_le32(super + 92);
+		u32 first_meta_bg = get_unaligned_le32(super + 260);
+		u64 group_count = blocks_per_group && block_count > first_data_block ?
+			(block_count - first_data_block + blocks_per_group - 1) /
+			blocks_per_group : 0;
+		u64 descriptor_blocks = group_count ?
+			(group_count * sizeof(struct ext2_block_group) + blocksize - 1) /
+			blocksize : 0;
+		u64 fs_sectors = (u64)block_count * (blocksize / 512);
+
+		if (get_unaligned_le16(super + 56) != EXT2_MAGIC ||
+		    get_unaligned_le32(super + 72) != 0 || revision > 1 ||
+		    get_unaligned_le32(super + 28) !=
+			get_unaligned_le32(super + 24) ||
+		    blocksize < 1024 || blocksize > JIBO_FILE_MAX_BYTES ||
+		    inode_size < 128 || inode_size > blocksize ||
+		    (inode_size & 3) ||
+		    (blocksize % inode_size) || inode_count < 2 ||
+		    block_count < 2 || !inodes_per_group ||
+		    inodes_per_group > inode_count || !blocks_per_group ||
+		    blocks_per_group > block_count ||
+		    blocks_per_group > blocksize * 8U ||
+		    inodes_per_group > blocksize * 8U ||
+		    first_data_block >= block_count ||
+		    group_count > 4096 ||
+		    ((incompat & 0x0010) &&
+		     (first_meta_bg >= descriptor_blocks || (compat & 0x0010))) ||
+		    get_unaligned_le32(super + 8) > block_count ||
+		    get_unaligned_le32(super + 16) > inode_count ||
+		    fs_sectors > part->size ||
+		    get_unaligned_le16(super + 58) != 1 ||
+		    (get_unaligned_le32(super + 96) & JIBO_EXT4_RECOVER)) {
+			status = JIBO_STATUS_UNSUPPORTED;
+			goto respond;
+		}
+	}
+	if (!ext4fs_mount(part->size)) {
+		status = JIBO_STATUS_METADATA;
+		goto respond;
+	}
+	mounted = 1;
+	blocksize = EXT2_BLOCK_SIZE(ext4fs_root);
+	if (blocksize < 1024 || blocksize > JIBO_FILE_MAX_BYTES ||
+	    blocksize % dev->blksz ||
+	    !__le32_to_cpu(ext4fs_root->sblock.inodes_per_group) ||
+	    !__le32_to_cpu(ext4fs_root->sblock.total_blocks) ||
+	    jibo_check_clean_journal(super, blocksize)) {
+		status = JIBO_STATUS_UNCLEAN;
+		goto respond;
+	}
+	if (memcmp(super + 104, ext4fs_root->sblock.unique_id, 16)) {
+		status = JIBO_STATUS_METADATA;
+		goto respond;
+	}
+	if (jibo_path_lookup(path, path_len, super, blocksize,
+			     &node, &found_ino)) {
+		status = JIBO_STATUS_NO_PATH;
+		goto respond;
+	}
+	inode_no = found_ino;
+	inode = node->inode;
+	if (jibo_file_metadata(node, inode_no, &inode, super, stat_buf,
+			       blocksize, &data_block)) {
+		status = JIBO_STATUS_UNSUPPORTED;
+		goto respond;
+	}
+	file_size = le32_to_cpu(inode.size);
+	if (file_size > JIBO_FILE_MAX_BYTES || file_size > blocksize) {
+		status = JIBO_STATUS_UNSUPPORTED;
+		goto respond;
+	}
+	file_data = memalign(ARCH_DMA_MINALIGN, blocksize);
+	if (!file_data) {
+		status = JIBO_STATUS_IO;
+		goto respond;
+	}
+	actual = 0;
+	if (ext4fs_read_file(node, 0, file_size, (char *)file_data, &actual) ||
+	    actual != file_size) {
+		status = JIBO_STATUS_IO;
+		goto respond;
+	}
+	if (operation == 1) {
+		body_len = file_size;
+		memcpy(response + JIBO_FILE_RESP_HEADER, file_data, body_len);
+		status = 0;
+	} else if (operation == 3) {
+		body_len = sizeof(stat_buf);
+		memcpy(response + JIBO_FILE_RESP_HEADER, stat_buf, body_len);
+		status = 0;
+	} else {
+		jibo_sha256(file_data, file_size, digest);
+		if (get_unaligned_le64(pre) != (u64)inode_no ||
+		    get_unaligned_le32(pre + 8) != file_size ||
+		    get_unaligned_le32(pre + 12) != blocksize ||
+		    get_unaligned_le32(pre + 16) != get_unaligned_le32(stat_buf + 16) ||
+		    get_unaligned_le32(pre + 20) != get_unaligned_le32(stat_buf + 20) ||
+		    get_unaligned_le32(pre + 24) != get_unaligned_le32(stat_buf + 24) ||
+		    memcmp(pre + 28, super + 104, 16) || memcmp(pre + 44, digest, 32)) {
+			status = JIBO_STATUS_PRECONDITION;
+		} else {
+			status = jibo_write_file(dev, part, node, inode_no, &inode,
+					 pre, new_data, content_len,
+					 blocksize, super, data_block);
+		}
+	}
+respond:
+	if (!response || !response_len)
+		return -1;
+	if (file_data)
+		free(file_data);
+	if (node)
+		ext4fs_free_node(node, ext4fs_root ? &ext4fs_root->diropen : NULL);
+	if (mounted)
+		ext4fs_close();
+	jibo_make_response(request_id, status,
+			   body_len ? response + JIBO_FILE_RESP_HEADER : NULL,
+			   body_len, response, response_len);
+	return 0;
+}
