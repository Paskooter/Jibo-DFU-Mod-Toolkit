+
+static int jibo_file_alt(struct dfu_entity *dfu, char *label, size_t label_size)
+{
+	const char *name = dfu->name;
+	const char *prefix = "jibo-file-";
+	size_t length, label_len;
+	int kind;
+
+	if (strncmp(name, prefix, strlen(prefix)))
+		return JIBO_FILE_ALT_NONE;
+	length = strlen(name);
+	if (length > 3 && !strcmp(name + length - 3, "-in"))
+		kind = JIBO_FILE_ALT_IN;
+	else if (length > 4 && !strcmp(name + length - 4, "-out"))
+		kind = JIBO_FILE_ALT_OUT;
+	else
+		return JIBO_FILE_ALT_NONE;
+	label_len = length - strlen(prefix) - (kind == JIBO_FILE_ALT_IN ? 3 : 4);
+	if (!label_len || label_len >= label_size)
+		return JIBO_FILE_ALT_NONE;
+	memcpy(label, name + strlen(prefix), label_len);
+	label[label_len] = '\0';
+	if (strcmp(label, "rootfsA") && strcmp(label, "rootfsB") &&
+	    strcmp(label, "services") && strcmp(label, "skills") &&
+	    strcmp(label, "var"))
+		return JIBO_FILE_ALT_NONE;
+	return kind;
+}
+
+static int jibo_file_partition(struct dfu_entity *dfu, struct mmc *mmc,
+			       const char *label, disk_partition_t *part)
+{
+	disk_partition_t other;
+	u64 end, other_end, last_usable;
+	int i;
+
+	if (dfu->data.mmc.dev_num != 0 || dfu->data.mmc.dev != 0 ||
+	    dfu->data.mmc.hw_partition >= 0 || mmc->block_dev.blksz != 512 ||
+	    part_get_info(&mmc->block_dev, dfu->data.mmc.part, part) ||
+	    strcmp(part->name, label) || part->blksz != 512 || !part->size ||
+	    part->start < 34 || part->start > mmc->block_dev.lba ||
+	    part->size > mmc->block_dev.lba - part->start ||
+	    mmc->block_dev.lba < 67)
+		return -1;
+	end = part->start + part->size;
+	last_usable = mmc->block_dev.lba - 33;
+	if (end > last_usable)
+		return -1;
+	/* Reject any GPT overlap before allowing the file RPC to touch blocks. */
+	for (i = 1; i <= 128; ++i) {
+		if (i == dfu->data.mmc.part ||
+		    part_get_info(&mmc->block_dev, i, &other))
+			continue;
+		if (!other.size || other.start > mmc->block_dev.lba ||
+		    other.size > mmc->block_dev.lba - other.start)
+			return -1;
+		other_end = other.start + other.size;
+		if (part->start < other_end && other.start < end)
+			return -1;
+	}
+	return 0;
+}
