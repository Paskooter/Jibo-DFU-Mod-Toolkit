+	if (jibo_file_alt(dfu, label, sizeof(label)) != JIBO_FILE_ALT_OUT ||
+	    !jibo_file_response_len ||
+	    jibo_file_response_len > sizeof(jibo_file_response) ||
+	    dfu->data.mmc.dev != jibo_file_response_dev ||
+	    dfu->data.mmc.part != jibo_file_response_partno ||
+	    strcmp(label, jibo_file_response_label))
+		return -EPERM;
+	mmc = find_mmc_device(dfu->data.mmc.dev_num);
+	if (!mmc || mmc_init(mmc) ||
+	    jibo_file_partition(dfu, mmc, label, &part) ||
+	    part.start != jibo_file_response_start ||
+	    part.size != jibo_file_response_size_lba)
+		return -EPERM;
+	dfu_file_buf_filled = -1;
+	return jibo_file_response_len;
+}
