+        "payload entry", "PMC STRAPPING_OPT_A", "RAM_CODE",
+        "board profile gate", "before SDRAM init", "after SDRAM init",
+        "DRAM size MiB", "required DRAM range flags",
+        "DRAM scratch word 0", "DRAM scratch word 1",
+        "DRAM scratch word 2", "DRAM scratch word 3",
+        "DRAM scratch restore flags", "blocked", "complete"
+    };
+
+    if (phase >= sizeof(names) / sizeof(names[0]))
+        return "unknown phase";
+    return names[phase];
+}
