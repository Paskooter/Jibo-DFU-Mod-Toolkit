+static int digest_equals_expected(const uint8_t digest[32])
+{
+    uint32_t i;
+    uint8_t different = 0;
+
+    for (i = 0; i < 32; i++)
+        different |= digest[i] ^ DFU_STAGE2_EXPECTED_SHA256[i];
+    return different == 0;
+}
+
+static int hash_loader_fd(int fd, uint8_t digest[32])
+{
+    uint8_t buffer[DFU_STAGE2_CHUNK_SIZE];
+    struct sha256_ctx ctx;
+    uint32_t total = 0;
+
+    if (lseek(fd, 0, SEEK_SET) < 0)
+        return -1;
+    sha256_init(&ctx);
+    for (;;) {
+        ssize_t count = read(fd, buffer, sizeof(buffer));
+        if (count < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        if (count == 0)
+            break;
+        total += (uint32_t)count;
+        if (total > DFU_STAGE2_LOADER_SIZE) {
+            errno = EFBIG;
+            return -1;
+        }
+        sha256_update(&ctx, buffer, (uint32_t)count);
+    }
+    if (total != DFU_STAGE2_LOADER_SIZE) {
+        errno = EINVAL;
+        return -1;
+    }
+    sha256_final(&ctx, digest);
+    if (lseek(fd, 0, SEEK_SET) < 0)
+        return -1;
+    return 0;
+}
