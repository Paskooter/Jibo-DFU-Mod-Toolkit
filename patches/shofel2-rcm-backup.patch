diff --git a/payloads/dfu_stage2.c b/payloads/dfu_stage2.c
new file mode 100644
index 0000000..fb4f926
--- /dev/null
+++ b/payloads/dfu_stage2.c
@@ -0,0 +1,226 @@
+#include "types.h"
+#include "t124.h"
+#include "dram_probe.h"
+#include "dram_probe_payload.h"
+#include "dfu_stage2_protocol.h"
+#include "sha256.h"
+
+typedef void (*ep1_x_imm_t)(void *buffer, u32 size, u32 *num_xfer);
+
+static const u8 expected_sha256[32] = {
+    0x8f, 0x46, 0x06, 0x2f, 0x2d, 0x20, 0x18, 0x24,
+    0x33, 0x70, 0x93, 0xa1, 0xe4, 0xc1, 0x54, 0xe3,
+    0x04, 0x8c, 0x01, 0x9b, 0x14, 0x79, 0x30, 0xda,
+    0x35, 0xb9, 0xd6, 0x2e, 0x00, 0xc5, 0xe6, 0x89
+};
+
+static u32 read32(uintptr_t addr)
+{
+    return *(volatile u32 *)addr;
+}
+
+static void copy_to_dram(u32 address, const u8 *source, u32 length)
+{
+    volatile u8 *destination = (volatile u8 *)address;
+    u32 i;
+
+    for (i = 0; i < length; i++)
+        destination[i] = source[i];
+}
+
+static void hash_dram(struct sha256_ctx *ctx, u32 address, u32 length,
+                      u8 *buffer)
+{
+    const volatile u8 *source = (const volatile u8 *)address;
+    u32 remaining = length;
+
+    sha256_init(ctx);
+    while (remaining != 0) {
+        u32 count = remaining > DFU_STAGE2_CHUNK_SIZE ?
+                    DFU_STAGE2_CHUNK_SIZE : remaining;
+        u32 i;
+        for (i = 0; i < count; i++)
+            buffer[i] = source[i];
+        sha256_update(ctx, buffer, count);
+        source += count;
+        remaining -= count;
+    }
+}
+
+static int digest_matches(const u8 *digest)
+{
+    u32 i;
+    u8 different = 0;
+
+    for (i = 0; i < 32; i++)
+        different |= digest[i] ^ expected_sha256[i];
+    return different == 0;
+}
+
+static void send_ack(ep1_x_imm_t ep1_in_write_imm,
+                     struct dfu_stage2_ack *ack, u32 code,
+                     u32 chunk_index, u32 length)
+{
+    u32 num_xfer = 0;
+
+    ack->magic[0] = 'J';
+    ack->magic[1] = 'A';
+    ack->magic[2] = 'C';
+    ack->magic[3] = 'K';
+    ack->version = DFU_STAGE2_VERSION;
+    ack->code = code;
+    ack->chunk_index = chunk_index;
+    ack->length = length;
+    ep1_in_write_imm(ack, sizeof(*ack), &num_xfer);
+}
+
+static int request_is_exact(const struct dfu_stage2_request *request)
+{
+    u32 i;
+    u8 different = 0;
+
+    if (request->magic[0] != 'J' || request->magic[1] != 'L' ||
+        request->magic[2] != 'D' || request->magic[3] != '1')
+        return 0;
+    if (request->version != DFU_STAGE2_VERSION ||
+        request->image_size != DFU_STAGE2_LOADER_SIZE ||
+        request->load_address != DFU_STAGE2_LOAD_ADDRESS ||
+        request->entry_address != DFU_STAGE2_ENTRY_ADDRESS ||
+        request->chunk_size != DFU_STAGE2_CHUNK_SIZE ||
+        request->entry_mode != DFU_STAGE2_ENTRY_MODE_ARM ||
+        (request->flags & ~DFU_STAGE2_FLAG_REQUEST_LAUNCH) != 0 ||
+        ((request->flags & DFU_STAGE2_FLAG_REQUEST_LAUNCH) &&
+         !DFU_STAGE2_ENABLE_LAUNCH))
+        return 0;
+    for (i = 0; i < 32; i++)
+        different |= request->sha256[i] ^ expected_sha256[i];
+    return different == 0;
+}
+
+static void await_final_control_and_reset(ep1_x_imm_t ep1_out_read_imm)
+{
+    char control[4];
+    u32 num_xfer = 0;
+
+    ep1_out_read_imm(control, sizeof(control), &num_xfer);
+    /* Launch stays disabled until the T124 A15 handoff has been verified. */
+    if (num_xfer == sizeof(control) &&
+        control[0] == 'J' && control[1] == 'R' &&
+        control[2] == 'C' && control[3] == 'M')
+        t124_enter_rcm();
+    t124_enter_rcm();
+}
+
+static void receive_loader(ep1_x_imm_t ep1_out_read_imm,
+                           ep1_x_imm_t ep1_in_write_imm,
+                           struct dfu_stage2_ack *ack)
+{
+    struct dfu_stage2_request request;
+    struct sha256_ctx hash_ctx;
+    u8 digest[32];
+    u8 *buffer = (u8 *)DFU_STAGE2_IRAM_BUFFER;
+    u32 num_xfer = 0;
+    u32 offset = 0;
+    u32 chunk_index = 0;
+
+    ep1_out_read_imm(&request, sizeof(request), &num_xfer);
+    if (num_xfer != sizeof(request) || !request_is_exact(&request)) {
+        send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_REJECTED,
+                 0, num_xfer);
+        await_final_control_and_reset(ep1_out_read_imm);
+    }
+
+    send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_ACCEPTED, 0,
+             DFU_STAGE2_LOADER_SIZE);
+    sha256_init(&hash_ctx);
+
+    while (offset < DFU_STAGE2_LOADER_SIZE) {
+        u32 length = DFU_STAGE2_LOADER_SIZE - offset;
+        if (length > DFU_STAGE2_CHUNK_SIZE)
+            length = DFU_STAGE2_CHUNK_SIZE;
+
+        num_xfer = 0;
+        ep1_out_read_imm(buffer, length, &num_xfer);
+        if (num_xfer != length) {
+            send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_READ_FAILED,
+                     chunk_index, num_xfer);
+            await_final_control_and_reset(ep1_out_read_imm);
+        }
+
+        copy_to_dram(DFU_STAGE2_LOAD_ADDRESS + offset, buffer, length);
+        sha256_update(&hash_ctx, buffer, length);
+        send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_CHUNK,
+                 chunk_index, length);
+        offset += length;
+        chunk_index++;
+    }
+
+    sha256_final(&hash_ctx, digest);
+    if (!digest_matches(digest)) {
+        send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_HASH_FAILED,
+                 chunk_index, 0);
+        await_final_control_and_reset(ep1_out_read_imm);
+    }
+
+    hash_dram(&hash_ctx, DFU_STAGE2_LOAD_ADDRESS,
+              DFU_STAGE2_LOADER_SIZE, buffer);
+    sha256_final(&hash_ctx, digest);
+    if (!digest_matches(digest)) {
+        send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_READBACK_FAILED,
+                 chunk_index, 0);
+        await_final_control_and_reset(ep1_out_read_imm);
+    }
+
+    if (read32(DFU_STAGE2_LOAD_ADDRESS) != DFU_STAGE2_VECTOR_WORD) {
+        send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_VECTOR_FAILED,
+                 chunk_index, 0);
+        await_final_control_and_reset(ep1_out_read_imm);
+    }
+
+    /* The image is verified in DRAM; wait for host to consume this response. */
+    send_ack(ep1_in_write_imm, ack, DFU_STAGE2_ACK_COMPLETE,
+             chunk_index, 0);
+    await_final_control_and_reset(ep1_out_read_imm);
+}
+
+__attribute__((section(".init")))
+void entry(void)
+{
+    struct dram_probe_report report;
+    struct dfu_stage2_ack ack;
+    u32 num_xfer = 0;
+    u32 regs_ready;
+    char start_request[4];
+    ep1_x_imm_t ep1_out_read_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_OUT_READ_IMM | 1u);
+    ep1_x_imm_t ep1_in_write_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_IN_WRITE_IMM | 1u);
+
+    start_request[0] = start_request[1] =
+        start_request[2] = start_request[3] = 0;
+    num_xfer = 0;
+    ep1_out_read_imm(start_request, sizeof(start_request), &num_xfer);
+    if (num_xfer != sizeof(start_request) ||
+        start_request[0] != 'J' || start_request[1] != 'S' ||
+        start_request[2] != 'T' || start_request[3] != 'G')
+        t124_enter_rcm();
+    (void)num_xfer;
+
+    regs_ready = dram_probe_read_report(&report);
+    if (regs_ready) {
+        report.scratch_addr = DRAM_PROBE_SCRATCH;
+        report.scratch_result =
+            dram_probe_round_trip(DRAM_PROBE_SCRATCH);
+    }
+    ep1_in_write_imm(&report, sizeof(report), &num_xfer);
+
+    if (!regs_ready ||
+        report.scratch_result != DRAM_PROBE_TEST_PASSED) {
+        char probe_ack[4];
+        num_xfer = 0;
+        ep1_out_read_imm(probe_ack, sizeof(probe_ack), &num_xfer);
+        t124_enter_rcm();
+    }
+
+    receive_loader(ep1_out_read_imm, ep1_in_write_imm, &ack);
+}
diff --git a/payloads/dram_probe.c b/payloads/dram_probe.c
new file mode 100644
index 0000000..ffa2479
--- /dev/null
+++ b/payloads/dram_probe.c
@@ -0,0 +1,51 @@
+#include "types.h"
+#include "t124.h"
+#include "dram_probe.h"
+#include "dram_probe_payload.h"
+
+typedef void (*ep1_x_imm_t)(void *buffer, u32 size, u32 *num_xfer);
+
+static void await_host_ack_then_reset(ep1_x_imm_t ep1_out_read_imm)
+{
+    char ack[4];
+    u32 num_xfer = 0;
+
+    ep1_out_read_imm(ack, sizeof(ack), &num_xfer);
+    /* Keep EP1 alive until the host has consumed the report. */
+    (void)num_xfer;
+    (void)ack;
+    t124_enter_rcm();
+}
+
+__attribute__((section(".init")))
+void entry(void)
+{
+    struct dram_probe_report report;
+    char request[4];
+    u32 request_len = 0;
+    u32 num_xfer = 0;
+    u32 regs_ready;
+    ep1_x_imm_t ep1_out_read_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_OUT_READ_IMM | 1u);
+    ep1_x_imm_t ep1_in_write_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_IN_WRITE_IMM | 1u);
+
+    /* BootROM EP1 services are request driven; do not send unsolicited IN. */
+    request[0] = request[1] = request[2] = request[3] = 0;
+    ep1_out_read_imm(request, sizeof(request), &request_len);
+    if (request_len != sizeof(request) ||
+        request[0] != 'J' || request[1] != 'D' ||
+        request[2] != 'R' || request[3] != 'Q')
+        t124_enter_rcm();
+    (void)request_len;
+
+    regs_ready = dram_probe_read_report(&report);
+    if (regs_ready) {
+        report.scratch_addr = DRAM_PROBE_SCRATCH;
+        report.scratch_result =
+            dram_probe_round_trip(DRAM_PROBE_SCRATCH);
+    }
+
+    ep1_in_write_imm(&report, sizeof(report), &num_xfer);
+    await_host_ack_then_reset(ep1_out_read_imm);
+}
diff --git a/payloads/dram_probe_common.c b/payloads/dram_probe_common.c
new file mode 100644
index 0000000..6ac88f6
--- /dev/null
+++ b/payloads/dram_probe_common.c
@@ -0,0 +1,147 @@
+#include "types.h"
+#include "t124.h"
+#include "dram_probe.h"
+#include "dram_probe_payload.h"
+
+static u32 read32(uintptr_t addr)
+{
+    return *(volatile u32 *)addr;
+}
+
+static void write32(uintptr_t addr, u32 value)
+{
+    *(volatile u32 *)addr = value;
+}
+
+void t124_enter_rcm(void)
+{
+    write32(PMC_BASE + PMC_SCRATCH0,
+            read32(PMC_BASE + PMC_SCRATCH0) | PMC_SCRATCH0_MODE_RCM);
+    write32(PMC_BASE + PMC_CNTRL,
+            read32(PMC_BASE + PMC_CNTRL) | PMC_CNTRL_MAIN_RST);
+    for (;;) {
+    }
+}
+
+static int bct_info_is_valid(u32 ptr, u32 size)
+{
+    if (size == 0 || size > IRAM_LEN)
+        return 0;
+    if (ptr < IRAM_BEGIN || ptr > IRAM_END)
+        return 0;
+    return size <= (IRAM_END + 1u - ptr);
+}
+
+u32 dram_probe_round_trip(u32 addr)
+{
+    volatile u32 *scratch = (volatile u32 *)addr;
+    u32 saved[4];
+    const u32 pattern[4] = {
+        0x5AA55AA5u, 0xA55AA55Au, 0x13579BDFu, 0xECA86420u
+    };
+    u32 ok = 1;
+    u32 i;
+
+    for (i = 0; i < 4; i++)
+        saved[i] = scratch[i];
+
+    for (i = 0; i < 4; i++)
+        scratch[i] = pattern[i];
+    for (i = 0; i < 4; i++) {
+        if (scratch[i] != pattern[i])
+            ok = 0;
+    }
+
+    for (i = 0; i < 4; i++)
+        scratch[i] = saved[i];
+    for (i = 0; i < 4; i++) {
+        if (scratch[i] != saved[i])
+            ok = 0;
+    }
+
+    return ok ? DRAM_PROBE_TEST_PASSED : DRAM_PROBE_TEST_FAILED;
+}
+
+u32 dram_probe_read_report(struct dram_probe_report *report)
+{
+    u32 ready = 1;
+    u32 emc_refctrl;
+    u32 emc_pin;
+    u32 emc_status;
+    u32 autocal_status;
+
+    report->magic[0] = 'J';
+    report->magic[1] = 'D';
+    report->magic[2] = 'R';
+    report->magic[3] = '1';
+    report->version = DRAM_PROBE_VERSION;
+    report->flags = 0;
+    report->bct_ptr = read32(NVBOOTINFOTABLE_BASE + NVBOOTINFOTABLE_BCTPTR);
+    report->bct_size = read32(NVBOOTINFOTABLE_BASE + NVBOOTINFOTABLE_BCTSIZE);
+    report->mc_emem_cfg = 0;
+    report->mc_emem_adr_cfg = 0;
+    report->mc_emem_arb_cfg = 0;
+    report->emc_cfg = 0;
+    report->emc_adr_cfg = 0;
+    report->emc_refctrl = 0;
+    report->emc_pin = 0;
+    report->emc_status = 0;
+    report->emc_auto_cal_status = 0;
+    report->scratch_addr = 0;
+    report->scratch_result = DRAM_PROBE_TEST_SKIPPED;
+    report->pmc_scratch0 = 0;
+
+    /* In forced RCM the BCT may be absent and MC can be clock gated.
+     * Reading MC_EMEM_CFG in that state stalls the AVP's APB transaction.
+     */
+    if (!bct_info_is_valid(report->bct_ptr, report->bct_size)) {
+        report->flags |= DRAM_PROBE_REGS_SKIPPED;
+        return 0;
+    }
+    report->flags |= DRAM_PROBE_BCT_VALID;
+
+    report->mc_emem_cfg = read32(T124_MC_BASE + T124_MC_EMEM_CFG);
+    report->mc_emem_adr_cfg = read32(T124_MC_BASE + T124_MC_EMEM_ADR_CFG);
+    report->mc_emem_arb_cfg = read32(T124_MC_BASE + T124_MC_EMEM_ARB_CFG);
+    report->emc_cfg = read32(T124_EMC_BASE + T124_EMC_CFG);
+    report->emc_adr_cfg = read32(T124_EMC_BASE + T124_EMC_ADR_CFG);
+    emc_refctrl = read32(T124_EMC_BASE + T124_EMC_REFCTRL);
+    emc_pin = read32(T124_EMC_BASE + T124_EMC_PIN);
+    emc_status = read32(T124_EMC_BASE + T124_EMC_STATUS);
+    autocal_status = read32(T124_EMC_BASE + T124_EMC_AUTO_CAL_STATUS);
+    report->emc_refctrl = emc_refctrl;
+    report->emc_pin = emc_pin;
+    report->emc_status = emc_status;
+    report->emc_auto_cal_status = autocal_status;
+    report->pmc_scratch0 = read32(PMC_BASE + PMC_SCRATCH0);
+
+    if (report->mc_emem_cfg != 0 && report->mc_emem_arb_cfg != 0)
+        report->flags |= DRAM_PROBE_MC_CONFIGURED;
+    else
+        ready = 0;
+
+    if (emc_refctrl & T124_EMC_REF_VALID)
+        report->flags |= DRAM_PROBE_REFRESH_ENABLED;
+    else
+        ready = 0;
+
+    if ((emc_pin & (T124_EMC_PIN_RESET_INACTIVE | T124_EMC_PIN_CKE_NORMAL)) ==
+        (T124_EMC_PIN_RESET_INACTIVE | T124_EMC_PIN_CKE_NORMAL))
+        report->flags |= DRAM_PROBE_PINS_ACTIVE;
+    else
+        ready = 0;
+
+    if ((emc_status & T124_EMC_TIMING_STALLED) == 0)
+        report->flags |= DRAM_PROBE_TIMING_READY;
+    else
+        ready = 0;
+
+    if ((autocal_status & T124_EMC_AUTO_CAL_ACTIVE) == 0)
+        report->flags |= DRAM_PROBE_AUTOCAL_IDLE;
+    else
+        ready = 0;
+
+    if (ready)
+        report->flags |= DRAM_PROBE_REGS_READY;
+    return ready;
+}
diff --git a/payloads/dram_trace.c b/payloads/dram_trace.c
new file mode 100644
index 0000000..8276ba1
--- /dev/null
+++ b/payloads/dram_trace.c
@@ -0,0 +1,163 @@
+#include "types.h"
+#include "t124.h"
+#include "dram_probe.h"
+#include "dram_probe_payload.h"
+#include "dram_trace.h"
+
+typedef void (*ep1_x_imm_t)(void *buffer, u32 size, u32 *num_xfer);
+
+static u32 read32(uintptr_t address)
+{
+    return *(volatile u32 *)address;
+}
+
+static void trace_phase(ep1_x_imm_t ep1_in_write_imm,
+                        ep1_x_imm_t ep1_out_read_imm,
+                        struct dram_trace_event *event,
+                        u32 phase, u32 value)
+{
+    struct dram_trace_ack ack;
+    u32 sent = 0;
+    u32 received = 0;
+
+    event->magic[0] = 'J';
+    event->magic[1] = 'D';
+    event->magic[2] = 'T';
+    event->magic[3] = '1';
+    event->phase = phase;
+    event->value = value;
+    ep1_in_write_imm(event, sizeof(*event), &sent);
+    (void)sent;
+
+    ep1_out_read_imm(&ack, sizeof(ack), &received);
+    if (received != sizeof(ack) ||
+        ack.magic[0] != 'J' || ack.magic[1] != 'T' ||
+        ack.magic[2] != 'A' || ack.magic[3] != 'K' ||
+        ack.phase != phase)
+        t124_enter_rcm();
+}
+
+static int bct_info_is_valid(u32 ptr, u32 size)
+{
+    if (size == 0 || size > IRAM_LEN)
+        return 0;
+    if (ptr < IRAM_BEGIN || ptr > IRAM_END)
+        return 0;
+    return size <= (IRAM_END + 1u - ptr);
+}
+
+__attribute__((section(".init")))
+void entry(void)
+{
+    struct dram_trace_event event;
+    ep1_x_imm_t ep1_out_read_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_OUT_READ_IMM | 1u);
+    ep1_x_imm_t ep1_in_write_imm =
+        (ep1_x_imm_t)(BOOTROM_EP1_IN_WRITE_IMM | 1u);
+    u32 bct_ptr, bct_size, mc_cfg, mc_adr, mc_arb;
+    u32 emc_cfg, emc_adr, emc_refctrl, emc_pin, emc_status, emc_autocal;
+    u32 gate = 1;
+    u32 flags = 0;
+    char request[4];
+    u32 request_len = 0;
+
+    request[0] = request[1] = request[2] = request[3] = 0;
+    ep1_out_read_imm(request, sizeof(request), &request_len);
+    if (request_len != sizeof(request) ||
+        request[0] != 'J' || request[1] != 'T' ||
+        request[2] != 'R' || request[3] != 'C')
+        t124_enter_rcm();
+    (void)request_len;
+
+    /* A visible handshake before any memory-mapped register access. */
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_ENTRY, 0);
+
+    bct_ptr = read32(NVBOOTINFOTABLE_BASE + NVBOOTINFOTABLE_BCTPTR);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_BCT_PTR, bct_ptr);
+    bct_size = read32(NVBOOTINFOTABLE_BASE + NVBOOTINFOTABLE_BCTSIZE);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_BCT_SIZE, bct_size);
+    if (bct_info_is_valid(bct_ptr, bct_size))
+        flags |= DRAM_PROBE_BCT_VALID;
+    else {
+        trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                    DRAM_TRACE_NOT_INITIALIZED, 0);
+        trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                    DRAM_TRACE_DONE, 0);
+        t124_enter_rcm();
+    }
+
+    mc_cfg = read32(T124_MC_BASE + T124_MC_EMEM_CFG);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_MC_EMEM_CFG, mc_cfg);
+    mc_adr = read32(T124_MC_BASE + T124_MC_EMEM_ADR_CFG);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_MC_EMEM_ADR_CFG, mc_adr);
+    mc_arb = read32(T124_MC_BASE + T124_MC_EMEM_ARB_CFG);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_MC_EMEM_ARB_CFG, mc_arb);
+    if (mc_cfg != 0 && mc_arb != 0)
+        flags |= DRAM_PROBE_MC_CONFIGURED;
+    else
+        gate = 0;
+
+    emc_cfg = read32(T124_EMC_BASE + T124_EMC_CFG);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_CFG, emc_cfg);
+    emc_adr = read32(T124_EMC_BASE + T124_EMC_ADR_CFG);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_ADR_CFG, emc_adr);
+    emc_refctrl = read32(T124_EMC_BASE + T124_EMC_REFCTRL);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_REFCTRL, emc_refctrl);
+    if (emc_refctrl & T124_EMC_REF_VALID)
+        flags |= DRAM_PROBE_REFRESH_ENABLED;
+    else
+        gate = 0;
+
+    emc_pin = read32(T124_EMC_BASE + T124_EMC_PIN);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_PIN, emc_pin);
+    if ((emc_pin & (T124_EMC_PIN_RESET_INACTIVE | T124_EMC_PIN_CKE_NORMAL)) ==
+        (T124_EMC_PIN_RESET_INACTIVE | T124_EMC_PIN_CKE_NORMAL))
+        flags |= DRAM_PROBE_PINS_ACTIVE;
+    else
+        gate = 0;
+
+    emc_status = read32(T124_EMC_BASE + T124_EMC_STATUS);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_STATUS, emc_status);
+    if ((emc_status & T124_EMC_TIMING_STALLED) == 0)
+        flags |= DRAM_PROBE_TIMING_READY;
+    else
+        gate = 0;
+
+    emc_autocal = read32(T124_EMC_BASE + T124_EMC_AUTO_CAL_STATUS);
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_EMC_AUTOCAL, emc_autocal);
+    if ((emc_autocal & T124_EMC_AUTO_CAL_ACTIVE) == 0)
+        flags |= DRAM_PROBE_AUTOCAL_IDLE;
+    else
+        gate = 0;
+
+    if (gate)
+        flags |= DRAM_PROBE_REGS_READY;
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_REGISTER_GATE, flags);
+
+    if (gate) {
+        u32 scratch_result =
+            dram_probe_round_trip(DRAM_PROBE_SCRATCH);
+        trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                    DRAM_TRACE_SCRATCH, scratch_result);
+    }
+
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_PMC_SCRATCH0,
+                read32(PMC_BASE + PMC_SCRATCH0));
+    trace_phase(ep1_in_write_imm, ep1_out_read_imm, &event,
+                DRAM_TRACE_DONE, gate);
+    t124_enter_rcm();
+}
