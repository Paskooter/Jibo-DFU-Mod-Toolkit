diff --git a/payloads/raminit/raminit_run.c b/payloads/raminit/raminit_run.c
new file mode 100644
index 0000000..95d6175
--- /dev/null
+++ b/payloads/raminit/raminit_run.c
@@ -0,0 +1,206 @@
+/*
+ * Single-core T124 experiment: initialize SDRAM from ShofEL's AVP Thumb
+ * payload, reporting and acknowledging every irreversible phase over EP1.
+ * This deliberately omits coreboot clock_init(): that routine reprograms
+ * PLLU/UTMIP and could tear down the BootROM USB endpoint used for reports.
+ */
+#include <stdint.h>
+
+#include <arch/io.h>
+#include <soc/addressmap.h>
+
+#include "jibo_raminit.h"
+#include "jibo_raminit_range.h"
+#include "pmc.h"
+#include "jibo_raminit_trace.h"
+#include "mc.h"
+#include "sdram.h"
+
+#define RAM_CODE_SLOT             2u
+#define RAM_CODE_MASK             PMC_STRAPPING_OPT_A_RAM_CODE_MASK
+#define RAM_CODE_SHIFT            PMC_STRAPPING_OPT_A_RAM_CODE_SHIFT
+
+extern const struct sdram_params jibo_ramcode2_sdram_params;
+uint32_t sdram_get_ram_code(void);
+
+struct ep1_context {
+	jibo_ep1_transfer_fn in_write;
+	jibo_ep1_transfer_fn out_read;
+};
+
+static void stop_in_iram(void) __attribute__((noreturn));
+static void stop_in_iram(void)
+{
+	for (;;)
+		__asm__ volatile("nop");
+}
+
+static int token_is(const char token[4], const char expected[4])
+{
+	return token[0] == expected[0] && token[1] == expected[1] &&
+	       token[2] == expected[2] && token[3] == expected[3];
+}
+
+static int receive_token(struct ep1_context *ep1, const char expected[4])
+{
+	char token[4] = { 0, 0, 0, 0 };
+	uint32_t received = 0;
+
+	ep1->out_read(token, sizeof(token), &received);
+	return received == sizeof(token) && token_is(token, expected);
+}
+
+/*
+ * Write one JDT1 event and wait for its matching JTAK before continuing.
+ * A bad/missing ACK leaves the AVP parked in IRAM; it never resets the chip.
+ */
+static void report_phase(struct ep1_context *ep1, uint32_t phase,
+			 uint32_t value)
+{
+	struct jibo_raminit_event event = {
+		.magic = { 'J', 'D', 'T', '1' },
+		.phase = phase,
+		.value = value,
+	};
+	struct jibo_raminit_ack ack;
+	uint32_t sent = 0;
+	uint32_t received = 0;
+
+	ep1->in_write(&event, sizeof(event), &sent);
+	(void)sent;
+
+	ep1->out_read(&ack, sizeof(ack), &received);
+	if (received != sizeof(ack) || !token_is(ack.magic, "JTAK") ||
+	    ack.phase != phase)
+		stop_in_iram();
+}
+
+static void report_scratch(struct ep1_context *ep1,
+			   struct jibo_raminit_status *status)
+{
+	static const uint32_t pattern[4] = {
+		0x4a424f31u, 0x74656e65u, 0x31323334u, 0xa5c35a3cu
+	};
+	volatile uint32_t *scratch = (volatile uint32_t *)JIBO_DRAM_SCRATCH;
+	uint32_t saved[4], observed[4], restored[4];
+	unsigned int i;
+	uint32_t flags = 0;
+
+	for (i = 0; i < 4; ++i)
+		saved[i] = scratch[i];
+	for (i = 0; i < 4; ++i)
+		scratch[i] = pattern[i];
+	__asm__ volatile("" ::: "memory");
+	for (i = 0; i < 4; ++i)
+		observed[i] = scratch[i];
+	for (i = 0; i < 4; ++i)
+		scratch[i] = saved[i];
+	__asm__ volatile("" ::: "memory");
+	for (i = 0; i < 4; ++i)
+		restored[i] = scratch[i];
+
+	for (i = 0; i < 4; ++i) {
+		if (observed[i] == pattern[i])
+			flags |= 1u << i;
+		if (restored[i] == saved[i])
+			flags |= 1u << (i + 4);
+	}
+	status->scratch_readback[0] = observed[0];
+	status->scratch_readback[1] = observed[1];
+	status->scratch_readback[2] = observed[2];
+	status->scratch_readback[3] = observed[3];
+	status->scratch_restore_flags = flags;
+	report_phase(ep1, JIBO_RAMINIT_SCRATCH_READBACK_0, observed[0]);
+	report_phase(ep1, JIBO_RAMINIT_SCRATCH_READBACK_1, observed[1]);
+	report_phase(ep1, JIBO_RAMINIT_SCRATCH_READBACK_2, observed[2]);
+	report_phase(ep1, JIBO_RAMINIT_SCRATCH_READBACK_3, observed[3]);
+	report_phase(ep1, JIBO_RAMINIT_SCRATCH_RESTORE_FLAGS, flags);
+}
+
+int jibo_init_dram(jibo_ep1_transfer_fn ep1_in_write_imm,
+		   jibo_ep1_transfer_fn ep1_out_read_imm,
+		   struct jibo_raminit_status *status)
+{
+	struct ep1_context ep1 = {
+		.in_write = ep1_in_write_imm,
+		.out_read = ep1_out_read_imm,
+	};
+	struct tegra_pmc_regs *pmc = (struct tegra_pmc_regs *)TEGRA_PMC_BASE;
+	struct tegra_mc_regs *mc = (struct tegra_mc_regs *)TEGRA_MC_BASE;
+	uint32_t raw_strap, ram_code, size_mb, ranges, emem_cfg;
+
+	if (!ep1.in_write || !ep1.out_read || !status)
+		return JIBO_RAMINIT_BAD_ARGUMENT;
+	status->raw_strapping_opt_a = 0;
+	status->ram_code = 0;
+	status->dram_size_mb = 0;
+	status->range_flags = 0;
+	status->scratch_readback[0] = 0;
+	status->scratch_readback[1] = 0;
+	status->scratch_readback[2] = 0;
+	status->scratch_readback[3] = 0;
+	status->scratch_restore_flags = 0;
+	status->result = JIBO_RAMINIT_BAD_ARGUMENT;
+
+	if (!receive_token(&ep1, JIBO_RAMINIT_REQUEST_MAGIC))
+		stop_in_iram();
+	/* Entry ACK confirms EP1 reporting before any PMC/EMC/MC access. */
+	report_phase(&ep1, JIBO_RAMINIT_ENTRY, 0);
+
+	/* PMC strap is safe preflight. Do not inspect MC/EMC until sdram_init. */
+	raw_strap = readl(&pmc->strapping_opt_a);
+	ram_code = sdram_get_ram_code();
+	status->raw_strapping_opt_a = raw_strap;
+	status->ram_code = ram_code;
+	report_phase(&ep1, JIBO_RAMINIT_PMC_STRAPPING_OPT_A, raw_strap);
+	report_phase(&ep1, JIBO_RAMINIT_RAM_CODE, ram_code);
+	if (ram_code != RAM_CODE_SLOT ||
+	    ram_code != ((raw_strap & RAM_CODE_MASK) >> RAM_CODE_SHIFT)) {
+		status->result = JIBO_RAMINIT_RAM_CODE_MISMATCH;
+		report_phase(&ep1, JIBO_RAMINIT_BLOCKED, ram_code);
+		report_phase(&ep1, JIBO_RAMINIT_DONE, 0);
+		return (int)status->result;
+	}
+
+	/*
+	 * RAM_CODE 2 does not distinguish Jibo board revisions. Require a
+	 * deliberate host attestation that this unit matches the Meerkat Rev02
+	 * profile before touching PLLM, EMC, or MC.
+	 */
+	if (!receive_token(&ep1, JIBO_RAMINIT_PROFILE_MAGIC)) {
+		status->result = JIBO_RAMINIT_PROFILE_NOT_CONFIRMED;
+		report_phase(&ep1, JIBO_RAMINIT_PROFILE_GATE, 0);
+		report_phase(&ep1, JIBO_RAMINIT_BLOCKED, RAM_CODE_SLOT);
+		report_phase(&ep1, JIBO_RAMINIT_DONE, 0);
+		return (int)status->result;
+	}
+	report_phase(&ep1, JIBO_RAMINIT_PROFILE_GATE, 1);
+
+	/* Coreboot's clock_sdram is reached from sdram_init; clock_init is skipped. */
+	report_phase(&ep1, JIBO_RAMINIT_BEFORE_SDRAM_INIT, RAM_CODE_SLOT);
+	sdram_init(&jibo_ramcode2_sdram_params);
+	report_phase(&ep1, JIBO_RAMINIT_AFTER_SDRAM_INIT, 1);
+
+	emem_cfg = readl(&mc->emem_cfg);
+	size_mb = (emem_cfg >> MC_EMEM_CFG_SIZE_MB_SHIFT) &
+		  MC_EMEM_CFG_SIZE_MB_MASK;
+	ranges = jibo_dram_range_flags(size_mb);
+	status->dram_size_mb = size_mb;
+	status->range_flags = ranges;
+	report_phase(&ep1, JIBO_RAMINIT_DRAM_SIZE_MB, size_mb);
+	report_phase(&ep1, JIBO_RAMINIT_DRAM_RANGE_FLAGS, ranges);
+	if ((ranges & JIBO_RANGE_ALL) != JIBO_RANGE_ALL) {
+		status->result = JIBO_RAMINIT_DRAM_RANGE_INVALID;
+		report_phase(&ep1, JIBO_RAMINIT_BLOCKED, ranges);
+		report_phase(&ep1, JIBO_RAMINIT_DONE, 0);
+		return (int)status->result;
+	}
+
+	/* At 0x80020000, save, test 16 bytes, and restore the prior contents. */
+	report_scratch(&ep1, status);
+	status->result = status->scratch_restore_flags == 0xffu ?
+		JIBO_RAMINIT_OK : JIBO_RAMINIT_SCRATCH_FAILED;
+	report_phase(&ep1, JIBO_RAMINIT_DONE,
+		     status->result == JIBO_RAMINIT_OK ? 1u : 0u);
+	return (int)status->result;
+}
diff --git a/payloads/raminit/timerus.c b/payloads/raminit/timerus.c
new file mode 100644
index 0000000..1f2c305
--- /dev/null
+++ b/payloads/raminit/timerus.c
@@ -0,0 +1,13 @@
+/* T124 microsecond-counter delay, usable before SDRAM exists. */
+#include <stdint.h>
+
+#define TEGRA_TMRUS_USEC_COUNTER 0x60005010u
+
+void udelay(unsigned usecs)
+{
+	volatile uint32_t *counter = (volatile uint32_t *)TEGRA_TMRUS_USEC_COUNTER;
+	uint32_t start = *counter;
+
+	while ((uint32_t)(*counter - start) < usecs)
+		__asm__ volatile("nop");
+}
