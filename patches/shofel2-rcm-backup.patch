+#define DFU_STAGE2_SPL_STACK_PROBE (DFU_STAGE2_SPL_STACK_ALIGNED_TOP - 16u)
+#define DFU_STAGE2_SPL_MALLOC_PROBE 0x80090000u
+#define DFU_STAGE2_SPL_MALLOC_SIZE 0x00010000u
+#define DFU_STAGE2_DRAM_BASE 0x80000000u
+#define DFU_STAGE2_EXPECTED_DRAM_SIZE_MB 2048u
