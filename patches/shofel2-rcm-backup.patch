+static int run_jibo_raminit(int rcm_usb, int confirm_meerkat_rev02,
+                            struct jibo_raminit_host_status *status)
+{
+    struct jibo_raminit_event event;
+    memset(status, 0, sizeof(*status));
+
+    for (;;) {
+        struct jibo_raminit_ack ack;
+
+        if (usb_receive_bulk_accumulate(rcm_usb, RCM_EP1_IN,
+                                        sizeof(event), &event) < 0) {
+            fprintf(stderr,
+                    "Error: timed out waiting for the Jibo SDRAM-init event stream.\n");
+            return -1;
+        }
+        if (memcmp(event.magic, JIBO_RAMINIT_EVENT_MAGIC, 4) ||
+            event.phase > JIBO_RAMINIT_DONE) {
+            fprintf(stderr, "Error: invalid Jibo SDRAM-init event.\n");
+            return -1;
+        }
+
+        printf("RAMINIT phase %u (%s): 0x%08x\n", event.phase,
+               jibo_raminit_phase_name(event.phase), event.value);
+        fflush(stdout);
+        if (event.phase < 32)
+            status->seen_phases |= 1u << event.phase;
+        switch (event.phase) {
+        case JIBO_RAMINIT_PMC_STRAPPING_OPT_A:
+            status->raw_strapping_opt_a = event.value;
+            break;
+        case JIBO_RAMINIT_RAM_CODE:
+            status->ram_code = event.value;
+            break;
+        case JIBO_RAMINIT_PROFILE_GATE:
+            status->profile_gate = event.value;
+            break;
+        case JIBO_RAMINIT_BEFORE_SDRAM_INIT:
+            status->init_before = event.value;
+            break;
+        case JIBO_RAMINIT_AFTER_SDRAM_INIT:
+            status->init_after = event.value;
+            break;
+        case JIBO_RAMINIT_DRAM_SIZE_MB:
+            status->dram_size_mb = event.value;
+            break;
+        case JIBO_RAMINIT_DRAM_RANGE_FLAGS:
+            status->range_flags = event.value;
+            break;
+        case JIBO_RAMINIT_SCRATCH_READBACK_0:
+        case JIBO_RAMINIT_SCRATCH_READBACK_1:
+        case JIBO_RAMINIT_SCRATCH_READBACK_2:
+        case JIBO_RAMINIT_SCRATCH_READBACK_3:
+            status->scratch_readback[event.phase -
+                                      JIBO_RAMINIT_SCRATCH_READBACK_0] =
+                event.value;
+            break;
+        case JIBO_RAMINIT_SCRATCH_RESTORE_FLAGS:
+            status->scratch_restore_flags = event.value;
+            break;
+        case JIBO_RAMINIT_DONE:
+            status->done_value = event.value;
+            break;
+        default:
+            break;
+        }
+
+        memcpy(ack.magic, JIBO_RAMINIT_ACK_MAGIC, 4);
+        ack.phase = event.phase;
+        if (usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(ack), &ack) < 0) {
+            fprintf(stderr,
+                    "Error: failed to acknowledge Jibo SDRAM-init phase.\n");
+            return -1;
+        }
+
+        if (event.phase == JIBO_RAMINIT_RAM_CODE && event.value == 2u) {
+            const char *profile_token = confirm_meerkat_rev02 ?
+                JIBO_RAMINIT_PROFILE_MAGIC : "JHLD";
+            if (send_profile_token(rcm_usb, profile_token) < 0) {
+                fprintf(stderr,
+                        "Error: failed to send the board-profile decision.\n");
+                return -1;
+            }
+            if (!confirm_meerkat_rev02) {
+                fprintf(stderr,
+                        "Meerkat Rev02 profile not confirmed; SDRAM init is blocked.\n");
+            }
+        }
+
+        if (event.phase == JIBO_RAMINIT_DONE)
+            break;
+    }
+
+    {
+        const uint32_t required_phases =
+            (1u << JIBO_RAMINIT_ENTRY) |
+            (1u << JIBO_RAMINIT_PMC_STRAPPING_OPT_A) |
+            (1u << JIBO_RAMINIT_RAM_CODE) |
+            (1u << JIBO_RAMINIT_PROFILE_GATE) |
+            (1u << JIBO_RAMINIT_BEFORE_SDRAM_INIT) |
+            (1u << JIBO_RAMINIT_AFTER_SDRAM_INIT) |
+            (1u << JIBO_RAMINIT_DRAM_SIZE_MB) |
+            (1u << JIBO_RAMINIT_DRAM_RANGE_FLAGS) |
+            (1u << JIBO_RAMINIT_SCRATCH_READBACK_0) |
+            (1u << JIBO_RAMINIT_SCRATCH_READBACK_1) |
+            (1u << JIBO_RAMINIT_SCRATCH_READBACK_2) |
+            (1u << JIBO_RAMINIT_SCRATCH_READBACK_3) |
+            (1u << JIBO_RAMINIT_SCRATCH_RESTORE_FLAGS) |
+            (1u << JIBO_RAMINIT_DONE);
+        if ((status->seen_phases & required_phases) != required_phases ||
+            status->done_value != 1u || status->ram_code != 2u ||
+            ((status->raw_strapping_opt_a & DFU_STAGE2_RAM_CODE_MASK) >>
+             DFU_STAGE2_RAM_CODE_SHIFT) != 2u ||
+            status->profile_gate != 1u || status->init_before != 2u ||
+            status->init_after != 1u ||
+            status->dram_size_mb != DFU_STAGE2_EXPECTED_DRAM_SIZE_MB ||
+            status->range_flags != 0x0fu ||
+            status->scratch_restore_flags != 0xffu ||
+            status->scratch_readback[0] != 0x4a424f31u ||
+            status->scratch_readback[1] != 0x74656e65u ||
+            status->scratch_readback[2] != 0x31323334u ||
+            status->scratch_readback[3] != 0xa5c35a3cu) {
+            fprintf(stderr,
+                    "Error: SDRAM init/profile/range/scratch checks did not pass; loader staging is blocked.\n");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static void print_dram_probe(const struct dram_probe_report *report)
+{
+    printf("T124 DRAM/EMC probe (no eMMC access)\n");
+    printf("  BootInfoTable BCT pointer/size: 0x%08x / 0x%08x (%s)\n",
+           report->bct_ptr, report->bct_size,
+           (report->flags & DRAM_PROBE_BCT_VALID) ? "valid" : "invalid");
+    if (report->flags & DRAM_PROBE_REGS_SKIPPED) {
+        printf("  MC/EMC register reads: skipped because no valid BCT is present.\n");
+        printf("  Register preflight: not ready; SDRAM access is disabled.\n");
+        printf("  DRAM scratch round-trip: skipped.\n");
+        return;
+    }
+    printf("  MC EMEM_CFG / ADR_CFG / ARB_CFG: 0x%08x / 0x%08x / 0x%08x\n",
+           report->mc_emem_cfg, report->mc_emem_adr_cfg,
+           report->mc_emem_arb_cfg);
+    printf("  EMC CFG / ADR_CFG: 0x%08x / 0x%08x\n",
+           report->emc_cfg, report->emc_adr_cfg);
+    printf("  EMC REFCTRL / PIN / STATUS / AUTOCAL: 0x%08x / 0x%08x / 0x%08x / 0x%08x\n",
+           report->emc_refctrl, report->emc_pin, report->emc_status,
+           report->emc_auto_cal_status);
+    printf("  Register preflight: %s\n",
+           (report->flags & DRAM_PROBE_REGS_READY) ? "ready" : "not ready");
+    if (report->scratch_result == DRAM_PROBE_TEST_PASSED) {
+        printf("  DRAM scratch round-trip at 0x%08x: passed (saved data restored)\n",
+               report->scratch_addr);
+    } else if (report->scratch_result == DRAM_PROBE_TEST_FAILED) {
+        printf("  DRAM scratch round-trip at 0x%08x: failed (saved data restored)\n",
+               report->scratch_addr);
+    } else {
+        printf("  DRAM scratch round-trip: skipped; register preflight did not pass\n");
+    }
+    printf("  PMC SCRATCH0: 0x%08x\n", report->pmc_scratch0);
+}
