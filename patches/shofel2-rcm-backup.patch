diff --git a/scripts/verify_boot0_bct.py b/scripts/verify_boot0_bct.py
new file mode 100644
index 0000000..1f35081
--- /dev/null
+++ b/scripts/verify_boot0_bct.py
@@ -0,0 +1,215 @@
+#!/usr/bin/env python3
+"""Compare SDRAM[2] in a bounded eMMC boot0 prefix with Jibo's 5.4.2 profile.
+
+Every parseable early copy must match the normalized official parameters. This
+does not validate BootROM signatures or journal copies beyond the 16 KiB prefix.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+
+DEFAULT_PROFILE = Path(__file__).resolve().parent / "data/jibo-meerkat-ramcode2-v1.json"
+PREFIX_SIZE = 16 * 1024
+BCT_SIZE = 8 * 1024
+SLOT = 2
+OFFICIAL_BCT_SHA256 = "13a1ab266b4fbbad9214270a38f300433b33d9b7cbc1698c71651b7887da7163"
+OFFICIAL_PROFILE_PARAMS_SHA256 = "5fe145a7abe61b80df3f79f1d15a0a723b387c3e6b7810c7d2df822fc03f4c85"
+OFFICIAL_NORMALIZED_SHA256 = "f7b695bfe019819db253ff60621c442b119a0cdb95ee334c2edf73e0be6bb3bd"
+SLOT_RE = re.compile(r"^SDRAM\[(\d+)\]\.([A-Za-z0-9]+)\s*=\s*(.*);$", re.M)
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical_parameter_hash(params):
+    rendered = json.dumps(params, sort_keys=True, separators=(",", ":")).encode()
+    return sha256(rendered)
+
+
+def normalize_value(text):
+    text = text.strip()
+    if text.startswith(("0x", "0X")):
+        return int(text, 16)
+    if text.isdecimal():
+        return int(text, 10)
+    return text
+
+
+def parse_slot2_dump(output, expected_fields):
+    values = {}
+    for found_slot, name, value in SLOT_RE.findall(output):
+        if int(found_slot) != SLOT:
+            continue
+        if name in values:
+            raise ValueError("duplicate BCT SDRAM[2] field: " + name)
+        values[name] = value.strip()
+    if not values:
+        raise ValueError("bct_dump returned no SDRAM[2] fields")
+    missing = sorted(set(expected_fields) - set(values))
+    extra = sorted(set(values) - set(expected_fields))
+    if missing or extra:
+        raise ValueError("BCT/profile field mismatch; missing=%s extra=%s" %
+                         (missing, extra))
+    if values.get("MemoryType") != "NvBootMemoryType_Ddr3":
+        raise ValueError("SDRAM[2] is not DDR3: %s" % values.get("MemoryType"))
+    return {name: normalize_value(value) for name, value in values.items()}
+
+
+def extract_slot2(bct_path, bct_dump, expected_fields):
+    raw = bct_path.read_bytes()
+    if len(raw) != BCT_SIZE:
+        raise ValueError("%s is %d bytes (expected exactly %d)" %
+                         (bct_path, len(raw), BCT_SIZE))
+    result = subprocess.run([str(bct_dump), str(bct_path)],
+                            check=False, stdout=subprocess.PIPE,
+                            stderr=subprocess.STDOUT, text=True)
+    if result.returncode:
+        raise ValueError("bct_dump failed for %s: %s" %
+                         (bct_path, result.stdout.strip()))
+    return parse_slot2_dump(result.stdout, expected_fields)
+
+
+def load_official_profile(profile_path):
+    data = json.loads(profile_path.read_text())
+    if data.get("schema") != "jibo-t124-sdram-params-v1" or \
+            data.get("ram_code") != 2 or data.get("sdram_slot") != SLOT:
+        raise ValueError("unexpected official profile schema/slot/RAM_CODE")
+    if data.get("source_bct_sha256") != OFFICIAL_BCT_SHA256 or \
+            data.get("source_bct_size") != BCT_SIZE:
+        raise ValueError("profile provenance does not match official 5.4.2 BCT")
+    if data.get("params_sha256") != OFFICIAL_PROFILE_PARAMS_SHA256:
+        raise ValueError("official profile metadata hash mismatch")
+    params = data.get("parameters")
+    if not isinstance(params, dict) or len(params) != 309 or \
+            data.get("parameter_count") != 309:
+        raise ValueError("official profile must contain 309 parameters")
+    if params.get("MemoryType") != "NvBootMemoryType_Ddr3":
+        raise ValueError("official SDRAM[2] profile is not DDR3")
+    params_hash = canonical_parameter_hash(params)
+    if params_hash != OFFICIAL_NORMALIZED_SHA256:
+        raise ValueError("normalized official profile hash mismatch: " + params_hash)
+    return data, params
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("prefix", type=Path,
+                        help="exactly 16 KiB saved by EMMC_READ_BOOT0_BCT")
+    parser.add_argument("--bct-dump", type=Path, required=True,
+                        help="path to NVIDIA bct_dump executable")
+    parser.add_argument("--profile-json", type=Path, default=DEFAULT_PROFILE,
+                        help="pinned normalized SDRAM[2] profile JSON")
+    parser.add_argument("--official-bct", type=Path,
+                        help="optional official BCT to cross-check the bundled profile")
+    parser.add_argument("--read-bl-len-exp", type=int, required=True,
+                        help="CSD READ_BL_LEN exponent printed by the boot0 reader")
+    args = parser.parse_args()
+
+    if not args.prefix.is_file():
+        parser.error("prefix file does not exist: " + str(args.prefix))
+    prefix = args.prefix.read_bytes()
+    if len(prefix) != PREFIX_SIZE:
+        parser.error("prefix must be exactly 16384 bytes; got %d" % len(prefix))
+    for tool_path in (args.bct_dump, args.profile_json):
+        if not tool_path.is_file():
+            parser.error("required verifier input is missing: " + str(tool_path))
+    if not 0 <= args.read_bl_len_exp <= 31:
+        parser.error("--read-bl-len-exp must be between 0 and 31")
+
+    try:
+        profile, official_params = load_official_profile(args.profile_json)
+    except (OSError, ValueError, json.JSONDecodeError) as exc:
+        parser.error("cannot load pinned official SDRAM[2] profile: " + str(exc))
+    if args.official_bct is not None:
+        try:
+            official_raw = args.official_bct.read_bytes()
+            if len(official_raw) != BCT_SIZE:
+                raise ValueError("official BCT must be exactly 8192 bytes")
+            official_hash = sha256(official_raw)
+            if official_hash != OFFICIAL_BCT_SHA256:
+                raise ValueError("official BCT SHA-256 mismatch: " + official_hash)
+            with tempfile.TemporaryDirectory(prefix="jibo-official-bct-") as tmp:
+                official_path = Path(tmp) / "official.bct"
+                official_path.write_bytes(official_raw)
+                parsed_official = extract_slot2(official_path, args.bct_dump,
+                                                official_params)
+            if parsed_official != official_params:
+                raise ValueError("official BCT SDRAM[2] differs from bundled profile")
+        except (OSError, ValueError, subprocess.SubprocessError) as exc:
+            parser.error("cannot cross-check official BCT: " + str(exc))
+    else:
+        official_hash = profile["source_bct_sha256"]
+
+    page_size = 1 << args.read_bl_len_exp
+    secondary_offset = ((BCT_SIZE + page_size - 1) // page_size) * page_size
+    if secondary_offset != BCT_SIZE:
+        parser.error("CSD page size implies the second 8 KiB BCT starts at %d; "
+                     "the 16 KiB prefix cannot contain both full copies" %
+                     secondary_offset)
+
+    official_params_hash = canonical_parameter_hash(official_params)
+    print("Boot0 prefix: %d bytes SHA-256 %s" %
+          (len(prefix), sha256(prefix)))
+    print("Official BCT provenance SHA-256 %s; SDRAM[2]: %d normalized fields, "
+          "parameters SHA-256 %s" %
+          (official_hash, len(official_params), official_params_hash))
+    print("CSD READ_BL_LEN exponent %d gives %d-byte pages; secondary BCT offset %d." %
+          (args.read_bl_len_exp, page_size, secondary_offset))
+
+    matches = []
+    mismatches = []
+    with tempfile.TemporaryDirectory(prefix="jibo-boot0-bct-") as tmp:
+        tmpdir = Path(tmp)
+        for offset in (0, BCT_SIZE):
+            copy = prefix[offset:offset + BCT_SIZE]
+            if len(copy) != BCT_SIZE:
+                print("offset %d: outside bounded prefix" % offset)
+                continue
+            candidate_path = tmpdir / ("candidate-%04x.bct" % offset)
+            candidate_path.write_bytes(copy)
+            try:
+                params = extract_slot2(candidate_path, args.bct_dump,
+                                       official_params)
+            except (OSError, ValueError, subprocess.SubprocessError) as exc:
+                print("offset %d: not a parseable SDRAM[2] BCT (%s)" %
+                      (offset, exc))
+                continue
+            params_hash = canonical_parameter_hash(params)
+            match = params == official_params
+            geometry = "; expected secondary-copy location" if offset == secondary_offset else ""
+            print("offset %d: %s, %d fields, normalized SHA-256 %s%s" %
+                  (offset, "MATCH" if match else "DIFFERS", len(params),
+                   params_hash, geometry))
+            if match:
+                matches.append(offset)
+            else:
+                mismatches.append(offset)
+
+    if mismatches:
+        print("Fail-closed: parseable early copy/copies differ at offset(s): %s." %
+              ", ".join(str(offset) for offset in mismatches), file=sys.stderr)
+        return 1
+    if not matches:
+        print("No parseable early BCT copy matched the official profile.",
+              file=sys.stderr)
+        return 1
+    print("Verified official SDRAM[2] parameters at byte offset(s): %s" %
+          ", ".join(str(offset) for offset in matches))
+    print("Limit: bct_dump parseability does not establish BootROM signature validity; "
+          "journal BCT copies beyond this 16 KiB prefix were not examined.")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except (OSError, ValueError, subprocess.SubprocessError) as exc:
+        print("error:", exc, file=sys.stderr)
+        sys.exit(1)
diff --git a/tests/check_stage2_artifact.py b/tests/check_stage2_artifact.py
new file mode 100644
index 0000000..6d58ba8
--- /dev/null
+++ b/tests/check_stage2_artifact.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Fail closed if the linked DFU stage payload lost its loader path."""
+
+import argparse
+import re
+import subprocess
+from pathlib import Path
+
+
+def run(*command):
+    try:
+        return subprocess.check_output(command, text=True, stderr=subprocess.STDOUT)
+    except (OSError, subprocess.CalledProcessError) as exc:
+        raise SystemExit(f"stage-2 artifact check failed running {command[0]}: {exc}")
+
+
+def check_binary(path):
+    size = Path(path).stat().st_size
+    if size <= 4096 or size > 199788:
+        raise SystemExit(
+            f"{path} has implausible size: {size} bytes (expected 4097..199788)"
+        )
+
+
+def check_elf(path, launch_enabled, nm, objdump):
+    symbol_output = run(nm, "-S", path)
+    symbols = {line.split()[-1] for line in symbol_output.splitlines() if line.split()}
+
+    required = {
+        "entry",
+        "jibo_init_dram",
+        "sha256_init",
+        "sha256_update",
+        "sha256_final",
+    }
+    has_symbol = lambda name: any(
+        symbol == name or symbol.startswith(name + ".") for symbol in symbols
+    )
+    missing = {name for name in required if not has_symbol(name)}
+    if not has_symbol("receive_loader"):
+        missing.add("receive_loader")
+    if missing:
+        raise SystemExit(
+            f"{path} is missing linked stage-2 routines: {', '.join(sorted(missing))}"
+        )
+
+    launch_present = has_symbol("t124_launch_spl")
+    if launch_enabled and not launch_present:
+        raise SystemExit(f"{path} is missing t124_launch_spl in the launch-enabled build")
+    if not launch_enabled and launch_present:
+        raise SystemExit(f"{path} unexpectedly contains t124_launch_spl in the default build")
+
+    disassembly = run(objdump, "-d", path)
+    entry_match = re.search(
+        r"(?ms)^[0-9a-f]+ <entry>:\n(.*?)(?=^[0-9a-f]+ <|\Z)", disassembly
+    )
+    if not entry_match:
+        raise SystemExit(f"{path} has no disassembled entry function")
+    entry_body = entry_match.group(1)
+    branch_to = lambda name, body: re.search(
+        rf"(?m)^\s*[0-9a-f]+:\s+[0-9a-f ]+\s+blx?\s+[^\n]*<{re.escape(name)}(?:\.[^>]*)?>",
+        body,
+    )
+    if not branch_to("receive_loader", entry_body):
+        raise SystemExit(
+            f"{path} entry does not call receive_loader; the RAM loader path is unreachable"
+        )
+
+    receiver_match = re.search(
+        r"(?ms)^[0-9a-f]+ <receive_loader(?:\.[^>]*)?>:\n(.*?)(?=^[0-9a-f]+ <|\Z)",
+        disassembly,
+    )
+    if not receiver_match:
+        raise SystemExit(f"{path} has no disassembled receive_loader function")
+    receiver_body = receiver_match.group(1)
+    missing_hash_passes = [
+        name for name in ("sha256_init", "sha256_update", "sha256_final")
+        if len(re.findall(
+            rf"(?m)^\s*[0-9a-f]+:\s+[0-9a-f ]+\s+blx?\s+[^\n]*<{re.escape(name)}(?:\.[^>]*)?>",
+            receiver_body,
+        )) < 2
+    ]
+    if missing_hash_passes:
+        raise SystemExit(
+            f"{path} receive_loader lacks stream and DRAM readback SHA passes: "
+            f"{', '.join(missing_hash_passes)}"
+        )
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--elf")
+    parser.add_argument("--bin")
+    parser.add_argument("--launch-enabled", type=int, choices=(0, 1))
+    parser.add_argument("--nm", default="arm-none-eabi-nm")
+    parser.add_argument("--objdump", default="arm-none-eabi-objdump")
+    args = parser.parse_args()
+
+    if not args.elf and not args.bin:
+        parser.error("provide --elf, --bin, or both")
+    if args.elf:
+        if args.launch_enabled is None:
+            parser.error("--elf requires --launch-enabled 0 or 1")
+        check_elf(args.elf, bool(args.launch_enabled), args.nm, args.objdump)
+    if args.bin:
+        check_binary(args.bin)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_emmc_boot0_protocol.c b/tests/test_emmc_boot0_protocol.c
new file mode 100644
index 0000000..a7fecf3
--- /dev/null
+++ b/tests/test_emmc_boot0_protocol.c
@@ -0,0 +1,42 @@
+#include <stdio.h>
+
+#include "emmc_server.h"
+
+int main(void) {
+    /* CSD.READ_BL_LEN comes from SDHCI RESPONSE+8 bits [11:8] after U-Boot's
+     * 136-bit response reconstruction. Nearby bits must not affect it. */
+    if (emmc_csd_read_bl_len_from_response_word2(0x123459abU) != 9U ||
+        emmc_csd_read_bl_len_from_response_word2(0x12345fabU) != 15U) {
+        fprintf(stderr, "CSD READ_BL_LEN response-word decode failed\n");
+        return 1;
+    }
+
+    /* Preserve all PARTITION_CONFIG boot settings while selecting boot0. */
+    if (emmc_boot0_selected_partconf(0x00000000U) != 0x00000001U ||
+        emmc_boot0_selected_partconf(0x000000a8U) != 0x000000a9U ||
+        emmc_boot0_selected_partconf(0x000000ffU) != 0x000000f9U) {
+        fprintf(stderr, "PARTITION_CONFIG boot0 selector failed\n");
+        return 1;
+    }
+
+    if (EMMC_CMD_READ_BOOT0_BCT != 0x07U ||
+        EMMC_BOOT0_BCT_PREFIX_SIZE != 16384U ||
+        EMMC_BOOT0_BCT_SECTORS != 32U ||
+        EMMC_BOOT0_REPORT_VERSION != 2U ||
+        sizeof(struct emmc_boot0_report_s) != 44U) {
+        fprintf(stderr, "boot0 wire-protocol layout changed unexpectedly\n");
+        return 1;
+    }
+
+    if (emmc_boot0_csd_command_error(0) != 0U ||
+        emmc_boot0_csd_command_error(-1) != EMMC_BOOT0_CSD_CMD_INHIBIT_TIMEOUT ||
+        emmc_boot0_csd_command_error(-2) != EMMC_BOOT0_CSD_CMD_INT_ERROR ||
+        emmc_boot0_csd_command_error(-3) != EMMC_BOOT0_CSD_CMD_COMPLETE_TIMEOUT ||
+        emmc_boot0_csd_command_error(-4) != EMMC_BOOT0_CSD_DAT_INHIBIT_TIMEOUT) {
+        fprintf(stderr, "boot0 CMD9 error diagnostic mapping failed\n");
+        return 1;
+    }
+
+    puts("Boot0 protocol vectors passed.");
+    return 0;
+}
diff --git a/tests/test_emmc_usb_framing.c b/tests/test_emmc_usb_framing.c
new file mode 100644
index 0000000..fcbf670
--- /dev/null
+++ b/tests/test_emmc_usb_framing.c
@@ -0,0 +1,138 @@
+#include <assert.h>
+#include <stdint.h>
+
+#include "emmc_server.h"
+
+/* Exercise the same host aggregation and payload frame sizing used by READ.
+ * Every sector must appear once and in order across both framing layers.
+ */
+static void check_write_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t frame_count = 0;
+
+    while (remaining > 0) {
+        uint32_t batch = emmc_write_batch_sectors(remaining);
+        uint32_t frame_bytes = batch * EMMC_SECTOR_SIZE;
+
+        assert(batch > 0);
+        assert(batch <= EMMC_CHUNK_SECTORS_WRITE);
+        assert(frame_bytes <= EMMC_CHUNK_BYTES);
+        assert(next_sector + batch <= sectors);
+
+        next_sector += batch;
+        remaining -= batch;
+        frame_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_CHUNK_SECTORS_WRITE - 1) / EMMC_CHUNK_SECTORS_WRITE);
+}
+
+static void check_read_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t transfer_count = 0;
+    uint32_t frame_count = 0;
+
+    while (remaining > 0) {
+        uint32_t transfer = emmc_read_usb_transfer_sectors(remaining);
+        uint32_t transfer_bytes = transfer * EMMC_SECTOR_SIZE;
+        uint32_t transfer_done = 0;
+        uint32_t transfer_start_sector = next_sector;
+
+        assert(transfer > 0);
+        assert(transfer <= EMMC_READ_USB_TRANSFER_SECTORS);
+        assert(transfer_bytes <= EMMC_READ_USB_TRANSFER_BYTES);
+        assert(transfer_bytes <= EMMC_CHUNK_BYTES);
+
+        /* Mock the payload's sequence of EP1_IN frames within one host read. */
+        while (transfer_done < transfer) {
+            uint32_t frame = emmc_read_frame_sectors(transfer - transfer_done);
+            uint32_t frame_bytes = frame * EMMC_SECTOR_SIZE;
+
+            assert(frame > 0);
+            assert(frame <= EMMC_READ_FRAME_SECTORS);
+            assert(frame_bytes <= EMMC_READ_FRAME_BYTES);
+            assert(next_sector == transfer_start_sector + transfer_done);
+            assert(next_sector + frame <= sectors);
+
+            next_sector += frame;
+            transfer_done += frame;
+            frame_count++;
+        }
+
+        assert(transfer_done == transfer);
+        assert(next_sector == transfer_start_sector + transfer);
+        remaining -= transfer;
+        transfer_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_READ_FRAME_SECTORS - 1) / EMMC_READ_FRAME_SECTORS);
+    assert(transfer_count == (sectors + EMMC_READ_USB_TRANSFER_SECTORS - 1) /
+                             EMMC_READ_USB_TRANSFER_SECTORS);
+}
+
+int main(void) {
+    unsigned char marker_frame[EMMC_READ_FRAME_BYTES];
+    uint32_t marker_tail = 0xdead0001U;
+
+    /* Keep CMD6's low CMD_SET byte zero, matching local U-Boot mmc_switch(). */
+    assert(EMMC_CMD6_SWITCH_WRITE_BYTE_ARG(183, 2) == 0x03B70200U);
+    assert(EMMC_CMD6_SWITCH_WRITE_BYTE_ARG(183, 0) == 0x03B70000U);
+
+    assert(EMMC_READ_FRAME_BYTES == 4 * 1024);
+    assert(EMMC_READ_FRAME_BYTES == EMMC_READ_BATCH_SECTORS * EMMC_SECTOR_SIZE);
+    assert(EMMC_READ_USB_TRANSFER_BYTES == 64 * 1024);
+    assert(EMMC_READ_USB_TRANSFER_BYTES ==
+           EMMC_READ_FRAMES_PER_USB_TRANSFER * EMMC_READ_FRAME_BYTES);
+    assert(EMMC_CHUNK_BYTES >= EMMC_READ_USB_TRANSFER_BYTES);
+    assert(EMMC_CHUNK_BYTES >= EMMC_CHUNK_SECTORS_WRITE * EMMC_SECTOR_SIZE);
+    assert(emmc_read_batch_sectors(0) == 0);
+    assert(emmc_read_batch_sectors(1) == 1);
+    assert(emmc_read_batch_sectors(8) == 8);
+    assert(emmc_read_batch_sectors(9) == 8);
+    assert(emmc_read_frame_sectors(0) == 0);
+    assert(emmc_read_frame_sectors(1) == 1);
+    assert(emmc_read_frame_sectors(8) == 8);
+    assert(emmc_read_frame_sectors(9) == 8);
+    assert(emmc_read_usb_transfer_sectors(0) == 0);
+    assert(emmc_read_usb_transfer_sectors(1) == 1);
+    assert(emmc_read_usb_transfer_sectors(128) == 128);
+    assert(emmc_read_usb_transfer_sectors(129) == 128);
+    marker_frame[0] = (unsigned char)(marker_tail & 0xffU);
+    marker_frame[1] = (unsigned char)((marker_tail >> 8) & 0xffU);
+    marker_frame[2] = (unsigned char)((marker_tail >> 16) & 0xffU);
+    marker_frame[3] = (unsigned char)((marker_tail >> 24) & 0xffU);
+    for (uint32_t i = 4; i < EMMC_READ_FRAME_BYTES; i += 4) {
+        marker_frame[i] = 0xad;
+        marker_frame[i + 1] = 0xde;
+        marker_frame[i + 2] = 0xad;
+        marker_frame[i + 3] = 0xde;
+    }
+    assert(emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0;
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0xde;
+    marker_frame[16] = 0; /* first-word prefix alone is not the full signature */
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    assert(emmc_write_batch_sectors(0) == 0);
+    assert(emmc_write_batch_sectors(1) == 1);
+    assert(emmc_write_batch_sectors(6) == 6);
+    assert(emmc_write_batch_sectors(7) == 6);
+
+    for (uint32_t sectors = 0; sectors <= 4096; sectors++) {
+        check_write_framing(sectors);
+        check_read_framing(sectors);
+    }
+
+    /* 500 MiB is 1,024,000 sectors: one host call per sixteen payload frames. */
+    assert((1024 * 1024 * 500 / EMMC_SECTOR_SIZE) == 1024000);
+    assert((1024000 + EMMC_READ_USB_TRANSFER_SECTORS - 1) /
+           EMMC_READ_USB_TRANSFER_SECTORS == 8000);
+    assert((1024000 + EMMC_READ_FRAME_SECTORS - 1) /
+           EMMC_READ_FRAME_SECTORS == 128000);
+
+    return 0;
+}
diff --git a/tests/test_sha256.c b/tests/test_sha256.c
new file mode 100644
index 0000000..9757621
--- /dev/null
+++ b/tests/test_sha256.c
@@ -0,0 +1,73 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "sha256.h"
+
+static int decode_hex(const char *hex, uint8_t *out, uint32_t length)
+{
+    uint32_t i;
+
+    for (i = 0; i < length; i++) {
+        unsigned int value;
+        if (sscanf(hex + i * 2u, "%2x", &value) != 1)
+            return -1;
+        out[i] = (uint8_t)value;
+    }
+    return 0;
+}
+
+static int check_vector(const char *message, uint32_t length,
+                        const char *expected_hex)
+{
+    struct sha256_ctx ctx;
+    uint8_t actual[32];
+    uint8_t expected[32];
+
+    if (decode_hex(expected_hex, expected, sizeof(expected)) < 0)
+        return -1;
+    sha256_init(&ctx);
+    sha256_update(&ctx, message, length);
+    sha256_final(&ctx, actual);
+    if (memcmp(actual, expected, sizeof(actual)) != 0) {
+        fprintf(stderr, "SHA-256 test vector failed for %u-byte input\n", length);
+        return -1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    static const char long_message[] =
+        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
+    struct sha256_ctx ctx;
+    uint8_t actual[32];
+    uint8_t expected[32];
+    const char *million_a_digest =
+        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0";
+    uint8_t block[1000];
+    uint32_t i;
+
+    if (check_vector("", 0,
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") < 0 ||
+        check_vector("abc", 3,
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") < 0 ||
+        check_vector(long_message, sizeof(long_message) - 1,
+        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") < 0)
+        return 1;
+
+    if (decode_hex(million_a_digest, expected, sizeof(expected)) < 0)
+        return 1;
+    memset(block, 'a', sizeof(block));
+    sha256_init(&ctx);
+    for (i = 0; i < 1000; i++)
+        sha256_update(&ctx, block, sizeof(block));
+    sha256_final(&ctx, actual);
+    if (memcmp(actual, expected, sizeof(actual)) != 0) {
+        fprintf(stderr, "SHA-256 million-byte streaming test failed\n");
+        return 1;
+    }
+
+    puts("SHA-256 vectors passed.");
+    return 0;
+}
diff --git a/tests/test_usb_bulk_accumulate.c b/tests/test_usb_bulk_accumulate.c
new file mode 100644
index 0000000..de2e064
--- /dev/null
+++ b/tests/test_usb_bulk_accumulate.c
@@ -0,0 +1,61 @@
+#include <assert.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "mini_libusb.h"
+#include "emmc_server.h"
+
+static uint32_t mock_stream_offset;
+static uint32_t mock_call_count;
+static uint32_t mock_max_chunk = 512;
+static uint32_t mock_zero_returns;
+
+int mock_ioctl(int fd, unsigned long request, ...) {
+    va_list args;
+    struct usbdevfs_bulktransfer *bulk;
+    uint32_t transferred;
+    unsigned char *destination;
+
+    (void)fd;
+    assert(request == USBDEVFS_BULK);
+    va_start(args, request);
+    bulk = va_arg(args, struct usbdevfs_bulktransfer *);
+    va_end(args);
+
+    assert(bulk->ep == 0x81);
+    assert(bulk->len > 0);
+    mock_call_count++;
+    if (mock_zero_returns > 0) {
+        mock_zero_returns--;
+        return 0;
+    }
+
+    transferred = (uint32_t)bulk->len;
+    if (transferred > mock_max_chunk)
+        transferred = mock_max_chunk;
+    destination = (unsigned char *)bulk->data;
+    for (uint32_t i = 0; i < transferred; i++)
+        destination[i] = (unsigned char)((mock_stream_offset + i) & 0xffU);
+    mock_stream_offset += transferred;
+    return (int)transferred;
+}
+
+int main(void) {
+    unsigned char buffer[EMMC_READ_USB_TRANSFER_BYTES];
+
+    mock_zero_returns = 1;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) == 0);
+    assert(mock_stream_offset == sizeof(buffer));
+    assert(mock_call_count == (sizeof(buffer) / mock_max_chunk) + 1);
+    for (uint32_t i = 0; i < sizeof(buffer); i++)
+        assert(buffer[i] == (unsigned char)(i & 0xffU));
+
+    mock_stream_offset = 0;
+    mock_call_count = 0;
+    mock_zero_returns = 5;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) < 0);
+    assert(mock_call_count == 4);
+    assert(mock_stream_offset == 0);
+
+    return 0;
+}
