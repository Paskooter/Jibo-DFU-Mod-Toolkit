diff --git a/payloads/raminit/vendor/coreboot-t124/stdlib.h b/payloads/raminit/vendor/coreboot-t124/stdlib.h
new file mode 100644
index 0000000..91d4c81
--- /dev/null
+++ b/payloads/raminit/vendor/coreboot-t124/stdlib.h
@@ -0,0 +1,31 @@
+#ifndef STDLIB_H
+#define STDLIB_H
+
+#include <stddef.h>
+
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+
+#define ALIGN(x,a)              __ALIGN_MASK(x,(typeof(x))(a)-1UL)
+#define __ALIGN_MASK(x,mask)    (((x)+(mask))&~(mask))
+#define ALIGN_UP(x,a)           ALIGN((x),(a))
+#define ALIGN_DOWN(x,a)         ((x) & ~((typeof(x))(a)-1UL))
+
+#define MIN(a,b) ((a) < (b) ? (a) : (b))
+#define MAX(a,b) ((a) > (b) ? (a) : (b))
+
+#if !defined(__PRE_RAM__)
+void *memalign(size_t boundary, size_t size);
+void *malloc(size_t size);
+/* We never free memory */
+static inline void free(void *ptr) {}
+#endif
+
+/* not sure romcc will know how to handle this. */
+#ifndef __ROMCC__
+static inline unsigned long div_round_up(unsigned int n, unsigned int d)
+{
+	return (n + d - 1) / d;
+}
+#endif
+
+#endif /* STDLIB_H */
