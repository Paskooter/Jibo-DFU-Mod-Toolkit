diff --git a/tests/test_emmc_usb_framing.c b/tests/test_emmc_usb_framing.c
new file mode 100644
index 0000000..cf24772
--- /dev/null
+++ b/tests/test_emmc_usb_framing.c
@@ -0,0 +1,101 @@
+#include <assert.h>
+#include <stdint.h>
+
+#include "emmc_server.h"
+
+/* Exercise the same batch sizing used by the host USB sender and payload
+ * receiver. Every sector must appear once, in order, with no oversized frame.
+ */
+static void check_write_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t frame_count = 0;
+
+    while (remaining > 0) {
+        uint32_t batch = emmc_write_batch_sectors(remaining);
+        uint32_t frame_bytes = batch * EMMC_SECTOR_SIZE;
+
+        assert(batch > 0);
+        assert(batch <= EMMC_CHUNK_SECTORS_WRITE);
+        assert(frame_bytes <= EMMC_CHUNK_BYTES);
+        assert(next_sector + batch <= sectors);
+
+        next_sector += batch;
+        remaining -= batch;
+        frame_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_CHUNK_SECTORS_WRITE - 1) / EMMC_CHUNK_SECTORS_WRITE);
+}
+
+static void check_read_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t frame_count = 0;
+    uint32_t batch_count = 0;
+
+    while (remaining > 0) {
+        uint32_t frame = emmc_read_frame_sectors(remaining);
+        uint32_t frame_bytes = frame * EMMC_SECTOR_SIZE;
+        uint32_t frame_done = 0;
+        uint32_t frame_start_sector = next_sector;
+
+        assert(frame > 0);
+        assert(frame <= EMMC_READ_FRAME_SECTORS);
+        assert(frame_bytes <= EMMC_CHUNK_BYTES);
+
+        while (frame_done < frame) {
+            uint32_t batch = emmc_read_batch_sectors(frame - frame_done);
+
+            assert(batch > 0);
+            assert(batch <= EMMC_READ_BATCH_SECTORS);
+            assert(next_sector == frame_start_sector + frame_done);
+            assert(next_sector + batch <= sectors);
+
+            next_sector += batch;
+            frame_done += batch;
+            batch_count++;
+        }
+
+        assert(frame_done == frame);
+        assert(next_sector == frame_start_sector + frame);
+        remaining -= frame;
+        frame_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_READ_FRAME_SECTORS - 1) / EMMC_READ_FRAME_SECTORS);
+    assert(batch_count == (sectors + EMMC_READ_BATCH_SECTORS - 1) / EMMC_READ_BATCH_SECTORS);
+}
+
+int main(void) {
+    assert(EMMC_READ_FRAME_BYTES == 64 * 1024);
+    assert(EMMC_READ_FRAME_BYTES % (EMMC_READ_BATCH_SECTORS * EMMC_SECTOR_SIZE) == 0);
+    assert(EMMC_CHUNK_BYTES >= EMMC_READ_FRAME_SECTORS * EMMC_SECTOR_SIZE);
+    assert(EMMC_CHUNK_BYTES >= EMMC_CHUNK_SECTORS_WRITE * EMMC_SECTOR_SIZE);
+    assert(emmc_read_batch_sectors(0) == 0);
+    assert(emmc_read_batch_sectors(1) == 1);
+    assert(emmc_read_batch_sectors(8) == 8);
+    assert(emmc_read_batch_sectors(9) == 8);
+    assert(emmc_read_frame_sectors(0) == 0);
+    assert(emmc_read_frame_sectors(1) == 1);
+    assert(emmc_read_frame_sectors(128) == 128);
+    assert(emmc_read_frame_sectors(129) == 128);
+    assert(emmc_write_batch_sectors(0) == 0);
+    assert(emmc_write_batch_sectors(1) == 1);
+    assert(emmc_write_batch_sectors(6) == 6);
+    assert(emmc_write_batch_sectors(7) == 6);
+
+    for (uint32_t sectors = 0; sectors <= 4096; sectors++) {
+        check_write_framing(sectors);
+        check_read_framing(sectors);
+    }
+
+    /* 500 MiB is 1,024,000 sectors: aggregate 16 4 KiB reads per USB call. */
+    assert((1024 * 1024 * 500 / EMMC_SECTOR_SIZE) == 1024000);
+    assert((1024000 + EMMC_READ_FRAME_SECTORS - 1) / EMMC_READ_FRAME_SECTORS == 8000);
+    assert((1024000 + EMMC_READ_BATCH_SECTORS - 1) / EMMC_READ_BATCH_SECTORS == 128000);
+
+    return 0;
+}
