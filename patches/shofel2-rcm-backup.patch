@@ -0,0 +1,38 @@
+#ifndef JIBO_RAMINIT_H
+#define JIBO_RAMINIT_H
+
+#include <stdint.h>
+
+enum jibo_raminit_result {
+	JIBO_RAMINIT_OK = 0,
+	JIBO_RAMINIT_BAD_ARGUMENT = 1,
+	JIBO_RAMINIT_RAM_CODE_MISMATCH = 2,
+	JIBO_RAMINIT_PROFILE_NOT_CONFIRMED = 3,
+	JIBO_RAMINIT_DRAM_RANGE_INVALID = 4,
+	JIBO_RAMINIT_SCRATCH_FAILED = 5
+};
+
+struct jibo_raminit_status {
+	uint32_t raw_strapping_opt_a;
+	uint32_t ram_code;
+	uint32_t dram_size_mb;
+	uint32_t range_flags;
+	uint32_t scratch_readback[4];
+	uint32_t scratch_restore_flags;
+	uint32_t result;
+};
+
+typedef void (*jibo_ep1_transfer_fn)(void *buffer, uint32_t size,
+				    uint32_t *num_xfer);
+
+/*
+ * Run the EP1 request/ACK protocol and initialize slot-2 DRAM only after the
+ * host sends JPRF. Returns JIBO_RAMINIT_OK on a completed scratch test; a
+ * profile/range gate failure returns its result without launching DRAM code.
+ * A missing or malformed event ACK parks the AVP in IRAM, without reset.
+ */
+int jibo_init_dram(jibo_ep1_transfer_fn ep1_in_write_imm,
+		   jibo_ep1_transfer_fn ep1_out_read_imm,
+		   struct jibo_raminit_status *status);
+
+#endif
diff --git a/payloads/raminit/include/jibo_raminit_range.h b/payloads/raminit/include/jibo_raminit_range.h
new file mode 100644
index 0000000..bb16e45
--- /dev/null
+++ b/payloads/raminit/include/jibo_raminit_range.h
@@ -0,0 +1,53 @@
+#ifndef JIBO_RAMINIT_RANGE_H
+#define JIBO_RAMINIT_RANGE_H
+
+#include <stdint.h>
+
+#define JIBO_DRAM_BASE                 0x80000000u
+#define JIBO_DRAM_SCRATCH              0x80020000u
+#define JIBO_DRAM_LOADER_BASE          0x80108000u
+#define JIBO_DRAM_LOADER_RESERVE_BYTES 0x00080000u
+#define JIBO_DRAM_SPL_STACK            0x800FFFFCu
+#define JIBO_DRAM_MALLOC_BASE          0x80090000u
+
+#define JIBO_RANGE_LOADER  (1u << 0)
+#define JIBO_RANGE_SPL     (1u << 1)
+#define JIBO_RANGE_MALLOC  (1u << 2)
+#define JIBO_RANGE_SCRATCH (1u << 3)
+#define JIBO_RANGE_ALL     0x0fu
+
+static inline int jibo_dram_region_fits(uint32_t dram_bytes,
+					uint32_t address,
+					uint32_t length)
+{
+	uint32_t offset;
+
+	if (address < JIBO_DRAM_BASE)
+		return 0;
+	offset = address - JIBO_DRAM_BASE;
+	return offset <= dram_bytes && length <= dram_bytes - offset;
+}
+
+/* The T124 aperture at 0x80000000 is at most 2 GiB in 32-bit address space. */
+static inline uint32_t jibo_dram_range_flags(uint32_t size_mb)
+{
+	uint32_t bytes;
+	uint32_t flags = 0;
+
+	if (size_mb == 0 || size_mb > 2048u)
+		return 0;
+	bytes = size_mb * 1024u * 1024u;
+	if (jibo_dram_region_fits(bytes, JIBO_DRAM_LOADER_BASE,
+				  JIBO_DRAM_LOADER_RESERVE_BYTES))
+		flags |= JIBO_RANGE_LOADER;
+	if (jibo_dram_region_fits(bytes, JIBO_DRAM_SPL_STACK, sizeof(uint32_t)))
+		flags |= JIBO_RANGE_SPL;
+	if (jibo_dram_region_fits(bytes, JIBO_DRAM_MALLOC_BASE, 1u))
+		flags |= JIBO_RANGE_MALLOC;
+	if (jibo_dram_region_fits(bytes, JIBO_DRAM_SCRATCH,
+				  4u * sizeof(uint32_t)))
+		flags |= JIBO_RANGE_SCRATCH;
+	return flags;
+}
+
+#endif
diff --git a/payloads/raminit/include/jibo_raminit_trace.h b/payloads/raminit/include/jibo_raminit_trace.h
new file mode 100644
index 0000000..aa0978e
--- /dev/null
+++ b/payloads/raminit/include/jibo_raminit_trace.h
@@ -0,0 +1,52 @@
+/*
+ * Small host-acknowledged EP1 protocol for the T124 AVP RAM-init prototype.
+ * The event and ACK packet layout reuses the existing ShofEL2 DRAM_TRACE
+ * framing so the host can keep the device in one RCM session.
+ */
+#ifndef JIBO_RAMINIT_TRACE_H
+#define JIBO_RAMINIT_TRACE_H
+
+#include <stdint.h>
+
+#define JIBO_RAMINIT_REQUEST_MAGIC "JTRC"
+#define JIBO_RAMINIT_EVENT_MAGIC   "JDT1"
+#define JIBO_RAMINIT_ACK_MAGIC     "JTAK"
+#define JIBO_RAMINIT_PROFILE_MAGIC "JPRF"
+#define JIBO_RAMINIT_EVENT_SIZE    12u
+#define JIBO_RAMINIT_ACK_SIZE      8u
+
+enum jibo_raminit_phase {
+	JIBO_RAMINIT_ENTRY = 0,
+	JIBO_RAMINIT_PMC_STRAPPING_OPT_A = 1,
+	JIBO_RAMINIT_RAM_CODE = 2,
+	JIBO_RAMINIT_PROFILE_GATE = 3,
+	JIBO_RAMINIT_BEFORE_SDRAM_INIT = 4,
+	JIBO_RAMINIT_AFTER_SDRAM_INIT = 5,
+	JIBO_RAMINIT_DRAM_SIZE_MB = 6,
+	JIBO_RAMINIT_DRAM_RANGE_FLAGS = 7,
+	JIBO_RAMINIT_SCRATCH_READBACK_0 = 8,
+	JIBO_RAMINIT_SCRATCH_READBACK_1 = 9,
+	JIBO_RAMINIT_SCRATCH_READBACK_2 = 10,
+	JIBO_RAMINIT_SCRATCH_READBACK_3 = 11,
+	JIBO_RAMINIT_SCRATCH_RESTORE_FLAGS = 12,
+	JIBO_RAMINIT_BLOCKED = 13,
+	JIBO_RAMINIT_DONE = 14
+};
+
+struct jibo_raminit_event {
+	char magic[4];
+	uint32_t phase;
+	uint32_t value;
+} __attribute__((packed));
+
+struct jibo_raminit_ack {
+	char magic[4];
+	uint32_t phase;
+} __attribute__((packed));
+
+typedef char jibo_raminit_event_size_check[
+	sizeof(struct jibo_raminit_event) == JIBO_RAMINIT_EVENT_SIZE ? 1 : -1];
+typedef char jibo_raminit_ack_size_check[
+	sizeof(struct jibo_raminit_ack) == JIBO_RAMINIT_ACK_SIZE ? 1 : -1];
+
+#endif
