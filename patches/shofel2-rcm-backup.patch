+#define JIBO_RAMINIT_CONSOLE_H
+
+#define BIOS_CRIT 0
+#define BIOS_ERR 1
+#define BIOS_WARNING 2
+#define BIOS_DEBUG 7
+
+/* No console is available before RAM init. Keep the imported coreboot calls
+ * side-effect free in this prototype. */
+#define printk(...) ((void)0)
+
+static inline __attribute__((noreturn)) void die(const char *message)
+{
+	(void)message;
+	for (;;)
+		__asm__ volatile("nop");
+}
+
+#endif
