+    uint32_t ram_code;
+    uint32_t profile_gate;
+    uint32_t init_before;
+    uint32_t init_after;
+    uint32_t dram_size_mb;
+    uint32_t range_flags;
+    uint32_t scratch_readback[4];
+    uint32_t scratch_restore_flags;
+    uint32_t done_value;
+    uint32_t seen_phases;
+};
