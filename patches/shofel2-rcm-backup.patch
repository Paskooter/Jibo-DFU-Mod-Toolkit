+#define DFU_STAGE2_ENTRY_MODE_ARM 0u
+#define DFU_STAGE2_REQUEST_SIZE 64u
+#define DFU_STAGE2_ACK_SIZE 20u
+#define DFU_STAGE2_IRAM_BUFFER 0x40020000u
+#define DFU_STAGE2_VECTOR_WORD 0xEA000016u
+#define DFU_STAGE2_SPL_STACK_TOP 0x800FFFFCu
