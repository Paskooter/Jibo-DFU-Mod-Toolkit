 }
 
+/* Some USBFS implementations complete a bulk-IN ioctl at each short packet
+ * boundary. Accumulate positive chunks so a caller can safely collect a
+ * stream composed of consecutive BootROM EP1_IN writes. */
+int usb_receive_bulk_accumulate( int usb, uint32_t ep, uint32_t len, void *data ) {
+
+    uint32_t received = 0;
+    uint32_t calls = 0;
+    uint32_t zero_length_completions = 0;
+    static int reported_short_chunk = 0;
+
+    while ( received < len ) {
+        struct usbdevfs_bulktransfer bulk_txn;
+        uint32_t requested = len - received;
+        memset( &bulk_txn, 0, sizeof ( bulk_txn ) );
+        bulk_txn.ep = ep;
+        bulk_txn.len = (int)requested;
+        bulk_txn.timeout = USB_BULK_TIMEOUT;
+        bulk_txn.data = (unsigned char *)data + received;
+
+        int transferred = ioctl( usb, USBDEVFS_BULK, &bulk_txn );
+        calls++;
+        if ( transferred < 0 ) {
+            int transfer_errno = errno;
+            fprintf( stderr,
+                     "USB bulk endpoint 0x%02x failed after receiving %u of %u bytes: %s\n",
+                     ep, received, len, strerror( transfer_errno ) );
+            return -1;
+        }
+        if ((uint32_t)transferred > requested) {
+            fprintf( stderr,
+                     "USB bulk endpoint 0x%02x returned invalid length %d for a %u-byte request\n",
+                     ep, transferred, requested );
+            return -1;
+        }
+        if ( transferred == 0 ) {
+            zero_length_completions++;
+            if ( zero_length_completions > 3 ) {
+                fprintf( stderr,
+                         "USB bulk endpoint 0x%02x made no progress after %u of %u bytes (%u zero-length completions)\n",
+                         ep, received, len, zero_length_completions );
+                return -1;
+            }
+        } else {
+            zero_length_completions = 0;
+            received += (uint32_t)transferred;
+            if ((uint32_t)transferred < requested && !reported_short_chunk) {
+                fprintf( stderr,
+                         "USB bulk endpoint 0x%02x returned a short chunk (%d of %u bytes); continuing at byte %u\n",
+                         ep, transferred, requested, received );
+                reported_short_chunk = 1;
+            }
+        }
+
+        if ( received < len && calls >= USB_BULK_ACCUMULATE_MAX_CALLS ) {
+            fprintf( stderr,
+                     "USB bulk endpoint 0x%02x exceeded %u requests after receiving %u of %u bytes\n",
+                     ep, USB_BULK_ACCUMULATE_MAX_CALLS, received, len );
+            return -1;
+        }
+    }
+
+    return 0;
+}
diff --git a/exploit/shofel2_t124.c b/exploit/shofel2_t124.c
