diff --git a/include/emmc_server.h b/include/emmc_server.h
index 5229e2e..dfea465 100644
--- a/include/emmc_server.h
+++ b/include/emmc_server.h
@@ -15,16 +15,32 @@
 #define EMMC_CMD_ERASE          0x05  /* Erase a range of sectors (forces reallocation) */
 #define EMMC_CMD_EXIT           0xFF
 
-/* Transfer chunk sizes basically the amount much data is sent/received per USB transfer was not multiple of 0x1000
- *
- * Reads: 8 sectors (4KB) = 1.1 MB/s - OPTIMIZED
- * Writes: 1 sector (512B) - ORIGINAL (safe)
+/* Keep eMMC PIO reads to 8-sector CMD18 batches. Aggregate up to 16 of those
+ * batches into one 64 KiB USB transfer to avoid a host ioctl per 4 KiB. The
+ * payload buffer at 0x40020000 has 128 KiB available in IRAM.
+ * Writes are transport-batched, but the payload still commits each sector
+ * with an individual CMD24 operation.
  */
-#define EMMC_CHUNK_SECTORS_READ    8
-#define EMMC_CHUNK_SECTORS_WRITE   1
-#define EMMC_CHUNK_SECTORS         1   /* Default - single sector for compatibility */
+#define EMMC_READ_BATCH_SECTORS    8
+#define EMMC_READ_FRAME_SECTORS    128
+#define EMMC_CHUNK_SECTORS_WRITE   6
+#define EMMC_CHUNK_SECTORS         1   /* Legacy default retained for compatibility */
 #define EMMC_SECTOR_SIZE           512
-#define EMMC_CHUNK_BYTES           (EMMC_CHUNK_SECTORS * EMMC_SECTOR_SIZE)
+#define EMMC_READ_FRAME_BYTES      (EMMC_READ_FRAME_SECTORS * EMMC_SECTOR_SIZE)
+#define EMMC_CHUNK_SECTORS_MAX     ((EMMC_READ_FRAME_SECTORS > EMMC_CHUNK_SECTORS_WRITE) ? EMMC_READ_FRAME_SECTORS : EMMC_CHUNK_SECTORS_WRITE)
+#define EMMC_CHUNK_BYTES           (EMMC_CHUNK_SECTORS_MAX * EMMC_SECTOR_SIZE)
+
+static inline uint32_t emmc_write_batch_sectors(uint32_t remaining) {
+    return remaining < EMMC_CHUNK_SECTORS_WRITE ? remaining : EMMC_CHUNK_SECTORS_WRITE;
+}
+
+static inline uint32_t emmc_read_batch_sectors(uint32_t remaining) {
+    return remaining < EMMC_READ_BATCH_SECTORS ? remaining : EMMC_READ_BATCH_SECTORS;
+}
+
+static inline uint32_t emmc_read_frame_sectors(uint32_t remaining) {
+    return remaining < EMMC_READ_FRAME_SECTORS ? remaining : EMMC_READ_FRAME_SECTORS;
+}
 
