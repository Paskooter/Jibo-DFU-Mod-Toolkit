+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <console/console.h>
+#include <timer.h>
+#include <delay.h>
+#include <thread.h>
+
+void init_timer(void)
+{
+}
+
+/* delay x useconds */
+void udelay(unsigned usec)
+{
+	struct mono_time current, end;
+
+	if (!thread_yield_microseconds(usec))
+		return;
+
+	timer_monotonic_get(&current);
+	end = current;
+	mono_time_add_usecs(&end, usec);
+
+	if (mono_time_after(&current, &end)) {
+		printk(BIOS_EMERG, "udelay: 0x%08x is impossibly large\n",
+				usec);
+		/* There's not much we can do if usec is too big. Use a long,
+		 * paranoid delay value and hope for the best... */
+		end = current;
+		mono_time_add_usecs(&end, USECS_PER_SEC);
+	}
+
+	while (mono_time_before(&current, &end))
+		timer_monotonic_get(&current);
+}
+
diff --git a/payloads/spl_launch.S b/payloads/spl_launch.S
new file mode 100644
index 0000000..7aaaed5
--- /dev/null
+++ b/payloads/spl_launch.S
@@ -0,0 +1,26 @@
+.syntax unified
+.thumb
+.thumb_func
+.global t124_launch_spl
+.type t124_launch_spl, %function
+
+/*
+ * This is intentionally only a CPU-state handoff. It assumes DRAM was
+ * initialized and validated, and that the full U-Boot SPL image was verified
+ * at 0x80108000 before the caller can reach it.
+ */
+t124_launch_spl:
+    ldr r3, =.Larm_entry
+    bx r3
+    .align 2
+
+.arm
+.Larm_entry:
+    /* Avoid entering SPL with IRQ/FIQ enabled. Preserve the current CPU mode. */
+    mrs r1, cpsr
+    orr r1, r1, #0xc0
+    msr cpsr_c, r1
+    ldr r0, =0x80108000
+    bx r0
+
+.size t124_launch_spl, .-t124_launch_spl
