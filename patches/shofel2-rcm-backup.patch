+        card_status = read32(SDMMC4_BASE + SDHCI_RESPONSE);
+        if (card_status & MMC_STATUS_SWITCH_ERROR) return -5;
+        if (card_status & MMC_STATUS_ERROR_MASK) return -6;
+        if ((card_status & MMC_STATUS_RDY_FOR_DATA) &&
