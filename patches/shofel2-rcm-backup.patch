 #include <time.h>
@@ -26,9 +31,299 @@ void print_hex_memory( void *mem, size_t size ) {
   printf( "\n" );
 }
 
+static int digest_equals_expected(const uint8_t digest[32])
+{
+    uint32_t i;
+    uint8_t different = 0;
+
+    for (i = 0; i < 32; i++)
+        different |= digest[i] ^ DFU_STAGE2_EXPECTED_SHA256[i];
+    return different == 0;
+}
+
+static int hash_loader_fd(int fd, uint8_t digest[32])
+{
+    uint8_t buffer[DFU_STAGE2_CHUNK_SIZE];
+    struct sha256_ctx ctx;
+    uint32_t total = 0;
+
+    if (lseek(fd, 0, SEEK_SET) < 0)
+        return -1;
+    sha256_init(&ctx);
+    for (;;) {
+        ssize_t count = read(fd, buffer, sizeof(buffer));
+        if (count < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        if (count == 0)
+            break;
+        total += (uint32_t)count;
+        if (total > DFU_STAGE2_LOADER_SIZE) {
+            errno = EFBIG;
+            return -1;
+        }
+        sha256_update(&ctx, buffer, (uint32_t)count);
+    }
+    if (total != DFU_STAGE2_LOADER_SIZE) {
+        errno = EINVAL;
+        return -1;
+    }
+    sha256_final(&ctx, digest);
+    if (lseek(fd, 0, SEEK_SET) < 0)
+        return -1;
+    return 0;
+}
+
+static int receive_stage_ack(int rcm_usb, struct dfu_stage2_ack *ack)
+{
+    int ret = usb_receive_bulk_accumulate(rcm_usb, RCM_EP1_IN,
+                                          sizeof(*ack), ack);
+    if (ret < 0)
+        return -1;
+    if (memcmp(ack->magic, DFU_STAGE2_ACK_MAGIC, 4) ||
+        ack->version != DFU_STAGE2_VERSION)
+        return -1;
+    return 0;
+}
+
+static int send_probe_ack(int rcm_usb)
+{
+    char ack[4] = { 'J', 'D', 'R', 'A' };
+
+    return usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(ack), ack);
+}
+
+static int send_start_token(int rcm_usb, const char magic[4])
+{
+    char token[4];
+
+    memcpy(token, magic, sizeof(token));
+    return usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(token), token);
+}
+
+static int send_stage_reset(int rcm_usb)
+{
+    char control[4] = { 'J', 'R', 'C', 'M' };
+
+    return usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(control), control);
+}
+
+static int receive_dram_probe(int rcm_usb,
+                              struct dram_probe_report *report)
+{
+    uint8_t bytes[DRAM_PROBE_REPORT_SIZE];
+    int ret;
+
+    memset(bytes, 0, sizeof(bytes));
+    ret = usb_receive_bulk_accumulate(rcm_usb, RCM_EP1_IN,
+                                      sizeof(bytes), bytes);
+    if (ret < 0)
+        return -1;
+    memcpy(report, bytes, sizeof(*report));
+    if (memcmp(report->magic, DRAM_PROBE_MAGIC, 4) ||
+        report->version != DRAM_PROBE_VERSION)
+        return -1;
+    return 0;
+}
+
+static const char *dram_trace_phase_name(uint32_t phase)
+{
+    static const char *const names[] = {
+        "payload entry", "BootInfoTable BCT pointer",
+        "BootInfoTable BCT size", "MC_EMEM_CFG",
+        "MC_EMEM_ADR_CFG", "MC_EMEM_ARB_CFG", "EMC_CFG",
+        "EMC_ADR_CFG", "EMC_REFCTRL", "EMC_PIN", "EMC_STATUS",
+        "EMC_AUTO_CAL_STATUS", "register gate", "DRAM scratch round-trip",
+        "PMC_SCRATCH0", "not initialized (BCT pointer/size invalid)",
+        "complete"
+    };
+
+    if (phase >= sizeof(names) / sizeof(names[0]))
+        return "unknown phase";
+    return names[phase];
+}
+
+static int run_dram_trace(int rcm_usb)
+{
+    struct dram_trace_event event;
+    uint32_t last_phase = DRAM_TRACE_ENTRY;
+    int have_phase = 0;
+
+    for (;;) {
+        struct dram_trace_ack ack;
+
+        if (usb_receive_bulk_accumulate(rcm_usb, RCM_EP1_IN,
+                                        sizeof(event), &event) < 0) {
+            if (have_phase) {
+                fprintf(stderr, "DRAM_TRACE stalled after phase %u (%s).\n",
+                        last_phase,
+                        dram_trace_phase_name(last_phase));
+            } else {
+                fprintf(stderr,
+                        "DRAM_TRACE stalled before the payload-entry marker.\n");
+            }
+            return -1;
+        }
+        if (memcmp(event.magic, DRAM_TRACE_MAGIC, 4) ||
+            event.phase > DRAM_TRACE_DONE) {
+            fprintf(stderr, "Error: invalid DRAM_TRACE event.\n");
+            return -1;
+        }
+
+        printf("DRAM_TRACE phase %u (%s): 0x%08x\n",
+               event.phase, dram_trace_phase_name(event.phase), event.value);
+        fflush(stdout);
+        last_phase = event.phase;
+        have_phase = 1;
+
+        memcpy(ack.magic, DRAM_TRACE_ACK_MAGIC, 4);
+        ack.phase = event.phase;
+        if (usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(ack), &ack) < 0) {
+            fprintf(stderr, "Error: failed to acknowledge DRAM_TRACE phase.\n");
+            return -1;
+        }
+        if (event.phase == DRAM_TRACE_DONE)
+            return 0;
+    }
+}
+
+static void print_dram_probe(const struct dram_probe_report *report)
+{
+    printf("T124 DRAM/EMC probe (no eMMC access)\n");
+    printf("  BootInfoTable BCT pointer/size: 0x%08x / 0x%08x (%s)\n",
+           report->bct_ptr, report->bct_size,
+           (report->flags & DRAM_PROBE_BCT_VALID) ? "valid" : "invalid");
+    if (report->flags & DRAM_PROBE_REGS_SKIPPED) {
+        printf("  MC/EMC register reads: skipped because no valid BCT is present.\n");
+        printf("  Register preflight: not ready; SDRAM access is disabled.\n");
+        printf("  DRAM scratch round-trip: skipped.\n");
+        return;
+    }
+    printf("  MC EMEM_CFG / ADR_CFG / ARB_CFG: 0x%08x / 0x%08x / 0x%08x\n",
+           report->mc_emem_cfg, report->mc_emem_adr_cfg,
+           report->mc_emem_arb_cfg);
+    printf("  EMC CFG / ADR_CFG: 0x%08x / 0x%08x\n",
+           report->emc_cfg, report->emc_adr_cfg);
+    printf("  EMC REFCTRL / PIN / STATUS / AUTOCAL: 0x%08x / 0x%08x / 0x%08x / 0x%08x\n",
+           report->emc_refctrl, report->emc_pin, report->emc_status,
+           report->emc_auto_cal_status);
+    printf("  Register preflight: %s\n",
+           (report->flags & DRAM_PROBE_REGS_READY) ? "ready" : "not ready");
+    if (report->scratch_result == DRAM_PROBE_TEST_PASSED) {
+        printf("  DRAM scratch round-trip at 0x%08x: passed (saved data restored)\n",
+               report->scratch_addr);
+    } else if (report->scratch_result == DRAM_PROBE_TEST_FAILED) {
+        printf("  DRAM scratch round-trip at 0x%08x: failed (saved data restored)\n",
+               report->scratch_addr);
+    } else {
+        printf("  DRAM scratch round-trip: skipped; register preflight did not pass\n");
+    }
+    printf("  PMC SCRATCH0: 0x%08x\n", report->pmc_scratch0);
+}
+
+static int stage_loader(int rcm_usb, int loader_fd, int launch_requested)
+{
+    struct dfu_stage2_request request;
+    struct dfu_stage2_ack ack;
+    uint8_t buffer[DFU_STAGE2_CHUNK_SIZE];
+    uint32_t offset = 0;
+    uint32_t chunk_index = 0;
+
+    memset(&request, 0, sizeof(request));
+    memcpy(request.magic, DFU_STAGE2_REQUEST_MAGIC, 4);
+    request.version = DFU_STAGE2_VERSION;
+    request.image_size = DFU_STAGE2_LOADER_SIZE;
+    request.load_address = DFU_STAGE2_LOAD_ADDRESS;
+    request.entry_address = DFU_STAGE2_ENTRY_ADDRESS;
+    request.chunk_size = DFU_STAGE2_CHUNK_SIZE;
+    request.entry_mode = DFU_STAGE2_ENTRY_MODE_ARM;
+    request.flags = launch_requested ? DFU_STAGE2_FLAG_REQUEST_LAUNCH : 0;
+    memcpy(request.sha256, DFU_STAGE2_EXPECTED_SHA256,
+           sizeof(request.sha256));
+
+    if (usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, sizeof(request), &request) < 0)
+        return -1;
+    if (receive_stage_ack(rcm_usb, &ack) < 0 ||
+        ack.code != DFU_STAGE2_ACK_ACCEPTED || ack.chunk_index != 0 ||
+        ack.length != DFU_STAGE2_LOADER_SIZE) {
+        fprintf(stderr, "Error: stage-2 rejected loader metadata.\n");
+        send_stage_reset(rcm_usb);
+        return -1;
+    }
+
+    while (offset < DFU_STAGE2_LOADER_SIZE) {
+        uint32_t length = DFU_STAGE2_LOADER_SIZE - offset;
+        uint32_t received = 0;
+
+        if (length > sizeof(buffer))
+            length = sizeof(buffer);
+        while (received < length) {
+            ssize_t count = read(loader_fd, buffer + received,
+                                 length - received);
+            if (count < 0) {
+                if (errno == EINTR)
+                    continue;
+                fprintf(stderr, "Error: reading loader file: %s\n",
+                        strerror(errno));
+                return -1;
+            }
+            if (count == 0) {
+                fprintf(stderr, "Error: loader file ended during transfer.\n");
+                return -1;
+            }
+            received += (uint32_t)count;
+        }
+
+        if (usb_send_bulk_txn(rcm_usb, RCM_EP1_OUT, length, buffer) < 0)
+            return -1;
+        if (receive_stage_ack(rcm_usb, &ack) < 0 ||
+            ack.code != DFU_STAGE2_ACK_CHUNK ||
+            ack.chunk_index != chunk_index || ack.length != length) {
+            fprintf(stderr, "Error: stage-2 transfer failed at chunk %u.\n",
+                    chunk_index);
+            send_stage_reset(rcm_usb);
+            return -1;
+        }
+        offset += length;
+        chunk_index++;
+        printf("\rStaged %u / %u bytes", offset, DFU_STAGE2_LOADER_SIZE);
+        fflush(stdout);
+    }
+    printf("\n");
+
+    if (receive_stage_ack(rcm_usb, &ack) < 0 ||
+        ack.code != DFU_STAGE2_ACK_COMPLETE ||
+        ack.chunk_index != chunk_index || ack.length != 0) {
+        fprintf(stderr,
+                "Error: stage-2 did not confirm both stream and DRAM readback hashes.\n");
+        send_stage_reset(rcm_usb);
+        return -1;
+    }
+    printf("Loader copied to 0x%08x and verified by SHA-256 readback.\n",
+           DFU_STAGE2_LOAD_ADDRESS);
+    if (launch_requested) {
+        fprintf(stderr, "Error: the Cortex-A15 launch path is not implemented.\n");
+        send_stage_reset(rcm_usb);
+        return -1;
+    }
+    if (send_stage_reset(rcm_usb) < 0) {
+        fprintf(stderr, "Error: failed to acknowledge the final transfer status.\n");
+        return -1;
+    }
+    printf("The SPL was not started; the robot is returning to RCM.\n");
+    return 0;
+}
