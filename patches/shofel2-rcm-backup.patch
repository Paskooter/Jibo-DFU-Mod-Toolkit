@@ -0,0 +1,52 @@
+#ifndef _DRAM_PROBE_H_
+#define _DRAM_PROBE_H_
+
+#include <stdint.h>
+
+#define DRAM_PROBE_MAGIC "JDR1"
+#define DRAM_PROBE_REQUEST_MAGIC "JDRQ"
+#define DRAM_PROBE_VERSION 1u
+#define DRAM_PROBE_REPORT_SIZE 68u
+#define DRAM_PROBE_HOST_ACK 0x4a445241u
+#define DRAM_PROBE_SCRATCH 0x80108000u
+
+#define DRAM_PROBE_BCT_VALID       (1u << 0)
+#define DRAM_PROBE_MC_CONFIGURED   (1u << 1)
+#define DRAM_PROBE_REFRESH_ENABLED (1u << 2)
+#define DRAM_PROBE_PINS_ACTIVE     (1u << 3)
+#define DRAM_PROBE_TIMING_READY    (1u << 4)
+#define DRAM_PROBE_AUTOCAL_IDLE    (1u << 5)
+#define DRAM_PROBE_REGS_SKIPPED    (1u << 6)
+#define DRAM_PROBE_REGS_READY      (1u << 31)
+
+enum dram_probe_test_result {
+    DRAM_PROBE_TEST_SKIPPED = 0,
+    DRAM_PROBE_TEST_PASSED = 1,
+    DRAM_PROBE_TEST_FAILED = 2
+};
+
+/* Fixed-width little-endian report shared by the ARM payload and host. */
+struct dram_probe_report {
+    char magic[4];
+    uint32_t version;
+    uint32_t flags;
+    uint32_t bct_ptr;
+    uint32_t bct_size;
+    uint32_t mc_emem_cfg;
+    uint32_t mc_emem_adr_cfg;
+    uint32_t mc_emem_arb_cfg;
+    uint32_t emc_cfg;
+    uint32_t emc_adr_cfg;
+    uint32_t emc_refctrl;
+    uint32_t emc_pin;
+    uint32_t emc_status;
+    uint32_t emc_auto_cal_status;
+    uint32_t scratch_addr;
+    uint32_t scratch_result;
+    uint32_t pmc_scratch0;
+} __attribute__((packed));
+
+typedef char dram_probe_report_must_be_68_bytes[
+    sizeof(struct dram_probe_report) == DRAM_PROBE_REPORT_SIZE ? 1 : -1];
+
+#endif
