+#define DFU_STAGE2_RAM_CODE_SHIFT 4u
+#define DFU_STAGE2_RAM_CODE_MASK (0x0Fu << DFU_STAGE2_RAM_CODE_SHIFT)
+#define DFU_STAGE2_FLAG_REQUEST_LAUNCH (1u << 0)
+#ifndef DFU_STAGE2_ENABLE_LAUNCH
+#define DFU_STAGE2_ENABLE_LAUNCH 0u
+#endif
+#define DFU_STAGE2_PROBE_ACK_MAGIC "JDRA"
+#define DFU_STAGE2_CONTROL_RESET_MAGIC "JRCM"
+#define DFU_STAGE2_CONTROL_LAUNCH_MAGIC "JGO1"
+
+enum dfu_stage2_ack_code {
+    DFU_STAGE2_ACK_ACCEPTED = 1,
+    DFU_STAGE2_ACK_CHUNK = 2,
+    DFU_STAGE2_ACK_COMPLETE = 3,
