+        marker_frame[i] = 0xad;
+        marker_frame[i + 1] = 0xde;
+        marker_frame[i + 2] = 0xad;
+        marker_frame[i + 3] = 0xde;
+    }
+    assert(emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0;
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0xde;
+    marker_frame[16] = 0; /* first-word prefix alone is not the full signature */
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    assert(emmc_write_batch_sectors(0) == 0);
+    assert(emmc_write_batch_sectors(1) == 1);
+    assert(emmc_write_batch_sectors(6) == 6);
+    assert(emmc_write_batch_sectors(7) == 6);
+
+    for (uint32_t sectors = 0; sectors <= 4096; sectors++) {
+        check_write_framing(sectors);
+        check_read_framing(sectors);
+    }
+
+    /* 500 MiB is 1,024,000 sectors: one host call per sixteen payload frames. */
+    assert((1024 * 1024 * 500 / EMMC_SECTOR_SIZE) == 1024000);
+    assert((1024000 + EMMC_READ_USB_TRANSFER_SECTORS - 1) /
+           EMMC_READ_USB_TRANSFER_SECTORS == 8000);
+    assert((1024000 + EMMC_READ_FRAME_SECTORS - 1) /
+           EMMC_READ_FRAME_SECTORS == 128000);
+
+    return 0;
+}
diff --git a/tests/test_usb_bulk_accumulate.c b/tests/test_usb_bulk_accumulate.c
new file mode 100644
index 0000000..de2e064
--- /dev/null
+++ b/tests/test_usb_bulk_accumulate.c
@@ -0,0 +1,61 @@
+#include <assert.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "mini_libusb.h"
+#include "emmc_server.h"
+
+static uint32_t mock_stream_offset;
+static uint32_t mock_call_count;
+static uint32_t mock_max_chunk = 512;
+static uint32_t mock_zero_returns;
+
+int mock_ioctl(int fd, unsigned long request, ...) {
+    va_list args;
+    struct usbdevfs_bulktransfer *bulk;
+    uint32_t transferred;
+    unsigned char *destination;
+
+    (void)fd;
+    assert(request == USBDEVFS_BULK);
+    va_start(args, request);
+    bulk = va_arg(args, struct usbdevfs_bulktransfer *);
+    va_end(args);
+
+    assert(bulk->ep == 0x81);
+    assert(bulk->len > 0);
+    mock_call_count++;
+    if (mock_zero_returns > 0) {
+        mock_zero_returns--;
+        return 0;
+    }
+
+    transferred = (uint32_t)bulk->len;
+    if (transferred > mock_max_chunk)
+        transferred = mock_max_chunk;
+    destination = (unsigned char *)bulk->data;
+    for (uint32_t i = 0; i < transferred; i++)
+        destination[i] = (unsigned char)((mock_stream_offset + i) & 0xffU);
+    mock_stream_offset += transferred;
+    return (int)transferred;
+}
+
+int main(void) {
+    unsigned char buffer[EMMC_READ_USB_TRANSFER_BYTES];
+
+    mock_zero_returns = 1;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) == 0);
+    assert(mock_stream_offset == sizeof(buffer));
+    assert(mock_call_count == (sizeof(buffer) / mock_max_chunk) + 1);
+    for (uint32_t i = 0; i < sizeof(buffer); i++)
+        assert(buffer[i] == (unsigned char)(i & 0xffU));
+
+    mock_stream_offset = 0;
+    mock_call_count = 0;
+    mock_zero_returns = 5;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) < 0);
+    assert(mock_call_count == 4);
+    assert(mock_stream_offset == 0);
+
+    return 0;
+}
