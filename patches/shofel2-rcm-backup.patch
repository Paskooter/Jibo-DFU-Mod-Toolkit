diff --git a/tests/test_emmc_usb_framing.c b/tests/test_emmc_usb_framing.c
new file mode 100644
index 0000000..fcbf670
--- /dev/null
+++ b/tests/test_emmc_usb_framing.c
@@ -0,0 +1,138 @@
+#include <assert.h>
+#include <stdint.h>
+
+#include "emmc_server.h"
+
+/* Exercise the same host aggregation and payload frame sizing used by READ.
+ * Every sector must appear once and in order across both framing layers.
+ */
+static void check_write_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t frame_count = 0;
+
+    while (remaining > 0) {
+        uint32_t batch = emmc_write_batch_sectors(remaining);
+        uint32_t frame_bytes = batch * EMMC_SECTOR_SIZE;
+
+        assert(batch > 0);
+        assert(batch <= EMMC_CHUNK_SECTORS_WRITE);
+        assert(frame_bytes <= EMMC_CHUNK_BYTES);
+        assert(next_sector + batch <= sectors);
+
+        next_sector += batch;
+        remaining -= batch;
+        frame_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_CHUNK_SECTORS_WRITE - 1) / EMMC_CHUNK_SECTORS_WRITE);
+}
+
+static void check_read_framing(uint32_t sectors) {
+    uint32_t remaining = sectors;
+    uint32_t next_sector = 0;
+    uint32_t transfer_count = 0;
+    uint32_t frame_count = 0;
+
+    while (remaining > 0) {
+        uint32_t transfer = emmc_read_usb_transfer_sectors(remaining);
+        uint32_t transfer_bytes = transfer * EMMC_SECTOR_SIZE;
+        uint32_t transfer_done = 0;
+        uint32_t transfer_start_sector = next_sector;
+
+        assert(transfer > 0);
+        assert(transfer <= EMMC_READ_USB_TRANSFER_SECTORS);
+        assert(transfer_bytes <= EMMC_READ_USB_TRANSFER_BYTES);
+        assert(transfer_bytes <= EMMC_CHUNK_BYTES);
+
+        /* Mock the payload's sequence of EP1_IN frames within one host read. */
+        while (transfer_done < transfer) {
+            uint32_t frame = emmc_read_frame_sectors(transfer - transfer_done);
+            uint32_t frame_bytes = frame * EMMC_SECTOR_SIZE;
+
+            assert(frame > 0);
+            assert(frame <= EMMC_READ_FRAME_SECTORS);
+            assert(frame_bytes <= EMMC_READ_FRAME_BYTES);
+            assert(next_sector == transfer_start_sector + transfer_done);
+            assert(next_sector + frame <= sectors);
+
+            next_sector += frame;
+            transfer_done += frame;
+            frame_count++;
+        }
+
+        assert(transfer_done == transfer);
+        assert(next_sector == transfer_start_sector + transfer);
+        remaining -= transfer;
+        transfer_count++;
+    }
+
+    assert(next_sector == sectors);
+    assert(frame_count == (sectors + EMMC_READ_FRAME_SECTORS - 1) / EMMC_READ_FRAME_SECTORS);
+    assert(transfer_count == (sectors + EMMC_READ_USB_TRANSFER_SECTORS - 1) /
+                             EMMC_READ_USB_TRANSFER_SECTORS);
+}
+
+int main(void) {
+    unsigned char marker_frame[EMMC_READ_FRAME_BYTES];
+    uint32_t marker_tail = 0xdead0001U;
+
+    /* Keep CMD6's low CMD_SET byte zero, matching local U-Boot mmc_switch(). */
+    assert(EMMC_CMD6_SWITCH_WRITE_BYTE_ARG(183, 2) == 0x03B70200U);
+    assert(EMMC_CMD6_SWITCH_WRITE_BYTE_ARG(183, 0) == 0x03B70000U);
+
+    assert(EMMC_READ_FRAME_BYTES == 4 * 1024);
+    assert(EMMC_READ_FRAME_BYTES == EMMC_READ_BATCH_SECTORS * EMMC_SECTOR_SIZE);
+    assert(EMMC_READ_USB_TRANSFER_BYTES == 64 * 1024);
+    assert(EMMC_READ_USB_TRANSFER_BYTES ==
+           EMMC_READ_FRAMES_PER_USB_TRANSFER * EMMC_READ_FRAME_BYTES);
+    assert(EMMC_CHUNK_BYTES >= EMMC_READ_USB_TRANSFER_BYTES);
+    assert(EMMC_CHUNK_BYTES >= EMMC_CHUNK_SECTORS_WRITE * EMMC_SECTOR_SIZE);
+    assert(emmc_read_batch_sectors(0) == 0);
+    assert(emmc_read_batch_sectors(1) == 1);
+    assert(emmc_read_batch_sectors(8) == 8);
+    assert(emmc_read_batch_sectors(9) == 8);
+    assert(emmc_read_frame_sectors(0) == 0);
+    assert(emmc_read_frame_sectors(1) == 1);
+    assert(emmc_read_frame_sectors(8) == 8);
+    assert(emmc_read_frame_sectors(9) == 8);
+    assert(emmc_read_usb_transfer_sectors(0) == 0);
+    assert(emmc_read_usb_transfer_sectors(1) == 1);
+    assert(emmc_read_usb_transfer_sectors(128) == 128);
+    assert(emmc_read_usb_transfer_sectors(129) == 128);
+    marker_frame[0] = (unsigned char)(marker_tail & 0xffU);
+    marker_frame[1] = (unsigned char)((marker_tail >> 8) & 0xffU);
+    marker_frame[2] = (unsigned char)((marker_tail >> 16) & 0xffU);
+    marker_frame[3] = (unsigned char)((marker_tail >> 24) & 0xffU);
+    for (uint32_t i = 4; i < EMMC_READ_FRAME_BYTES; i += 4) {
+        marker_frame[i] = 0xad;
+        marker_frame[i + 1] = 0xde;
+        marker_frame[i + 2] = 0xad;
+        marker_frame[i + 3] = 0xde;
+    }
+    assert(emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0;
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    marker_frame[EMMC_READ_FRAME_BYTES - 1] = 0xde;
+    marker_frame[16] = 0; /* first-word prefix alone is not the full signature */
+    assert(!emmc_read_frame_has_error_marker(marker_frame, EMMC_READ_FRAME_BYTES));
+    assert(emmc_write_batch_sectors(0) == 0);
+    assert(emmc_write_batch_sectors(1) == 1);
+    assert(emmc_write_batch_sectors(6) == 6);
+    assert(emmc_write_batch_sectors(7) == 6);
+
+    for (uint32_t sectors = 0; sectors <= 4096; sectors++) {
+        check_write_framing(sectors);
+        check_read_framing(sectors);
+    }
+
+    /* 500 MiB is 1,024,000 sectors: one host call per sixteen payload frames. */
+    assert((1024 * 1024 * 500 / EMMC_SECTOR_SIZE) == 1024000);
+    assert((1024000 + EMMC_READ_USB_TRANSFER_SECTORS - 1) /
+           EMMC_READ_USB_TRANSFER_SECTORS == 8000);
+    assert((1024000 + EMMC_READ_FRAME_SECTORS - 1) /
+           EMMC_READ_FRAME_SECTORS == 128000);
+
+    return 0;
+}
diff --git a/tests/test_sha256.c b/tests/test_sha256.c
new file mode 100644
index 0000000..9757621
--- /dev/null
+++ b/tests/test_sha256.c
@@ -0,0 +1,73 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "sha256.h"
+
+static int decode_hex(const char *hex, uint8_t *out, uint32_t length)
+{
+    uint32_t i;
+
+    for (i = 0; i < length; i++) {
+        unsigned int value;
+        if (sscanf(hex + i * 2u, "%2x", &value) != 1)
+            return -1;
+        out[i] = (uint8_t)value;
+    }
+    return 0;
+}
+
+static int check_vector(const char *message, uint32_t length,
+                        const char *expected_hex)
+{
+    struct sha256_ctx ctx;
+    uint8_t actual[32];
+    uint8_t expected[32];
+
+    if (decode_hex(expected_hex, expected, sizeof(expected)) < 0)
+        return -1;
+    sha256_init(&ctx);
+    sha256_update(&ctx, message, length);
+    sha256_final(&ctx, actual);
+    if (memcmp(actual, expected, sizeof(actual)) != 0) {
+        fprintf(stderr, "SHA-256 test vector failed for %u-byte input\n", length);
+        return -1;
+    }
+    return 0;
+}
+
+int main(void)
+{
+    static const char long_message[] =
+        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
+    struct sha256_ctx ctx;
+    uint8_t actual[32];
+    uint8_t expected[32];
+    const char *million_a_digest =
+        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0";
+    uint8_t block[1000];
+    uint32_t i;
+
+    if (check_vector("", 0,
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") < 0 ||
+        check_vector("abc", 3,
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") < 0 ||
+        check_vector(long_message, sizeof(long_message) - 1,
+        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") < 0)
+        return 1;
+
+    if (decode_hex(million_a_digest, expected, sizeof(expected)) < 0)
+        return 1;
+    memset(block, 'a', sizeof(block));
+    sha256_init(&ctx);
+    for (i = 0; i < 1000; i++)
+        sha256_update(&ctx, block, sizeof(block));
+    sha256_final(&ctx, actual);
+    if (memcmp(actual, expected, sizeof(actual)) != 0) {
+        fprintf(stderr, "SHA-256 million-byte streaming test failed\n");
+        return 1;
+    }
+
+    puts("SHA-256 vectors passed.");
+    return 0;
+}
diff --git a/tests/test_usb_bulk_accumulate.c b/tests/test_usb_bulk_accumulate.c
new file mode 100644
index 0000000..de2e064
--- /dev/null
+++ b/tests/test_usb_bulk_accumulate.c
@@ -0,0 +1,61 @@
+#include <assert.h>
+#include <stdarg.h>
+#include <stdint.h>
+
+#include "mini_libusb.h"
+#include "emmc_server.h"
+
+static uint32_t mock_stream_offset;
+static uint32_t mock_call_count;
+static uint32_t mock_max_chunk = 512;
+static uint32_t mock_zero_returns;
+
+int mock_ioctl(int fd, unsigned long request, ...) {
+    va_list args;
+    struct usbdevfs_bulktransfer *bulk;
+    uint32_t transferred;
+    unsigned char *destination;
+
+    (void)fd;
+    assert(request == USBDEVFS_BULK);
+    va_start(args, request);
+    bulk = va_arg(args, struct usbdevfs_bulktransfer *);
+    va_end(args);
+
+    assert(bulk->ep == 0x81);
+    assert(bulk->len > 0);
+    mock_call_count++;
+    if (mock_zero_returns > 0) {
+        mock_zero_returns--;
+        return 0;
+    }
+
+    transferred = (uint32_t)bulk->len;
+    if (transferred > mock_max_chunk)
+        transferred = mock_max_chunk;
+    destination = (unsigned char *)bulk->data;
+    for (uint32_t i = 0; i < transferred; i++)
+        destination[i] = (unsigned char)((mock_stream_offset + i) & 0xffU);
+    mock_stream_offset += transferred;
+    return (int)transferred;
+}
+
+int main(void) {
+    unsigned char buffer[EMMC_READ_USB_TRANSFER_BYTES];
+
+    mock_zero_returns = 1;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) == 0);
+    assert(mock_stream_offset == sizeof(buffer));
+    assert(mock_call_count == (sizeof(buffer) / mock_max_chunk) + 1);
+    for (uint32_t i = 0; i < sizeof(buffer); i++)
+        assert(buffer[i] == (unsigned char)(i & 0xffU));
+
+    mock_stream_offset = 0;
+    mock_call_count = 0;
+    mock_zero_returns = 5;
+    assert(usb_receive_bulk_accumulate(7, 0x81, sizeof(buffer), buffer) < 0);
+    assert(mock_call_count == 4);
+    assert(mock_stream_offset == 0);
+
+    return 0;
+}
